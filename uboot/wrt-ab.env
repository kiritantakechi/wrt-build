/*
 * A/B slot logic (design D3), built into the R4S's and the emulator's U-Boot
 * after their board constants: wrt_mmc (the SD card), wrt_console (the console
 * arguments) and wrt_bootos (how to start the kernel in a slot's FIT).
 *
 * Only boot_slot, bootcount and upgrade_available are read from the stored
 * environment (ENV_WRITEABLE_LIST), so the logic always comes from this binary.
 * bootcmd runs wrt_boot; once bootcount exceeds bootlimit during a trial boot,
 * altbootcmd runs wrt_rollback instead (both set in wrt-ab.config).
 */

/* Boot boot_slot: a unless it is b. Partitions: boot-A 1, root-A 2, boot-B 3, root-B 4. */
wrt_boot=
	if test "${boot_slot}" = b; then
		setenv wrt_bp 3; setenv wrt_rp 4;
	else
		setenv boot_slot a; setenv wrt_bp 1; setenv wrt_rp 2;
	fi;
	part uuid mmc ${wrt_mmc}:${wrt_rp} wrt_root;
	setenv bootargs ${wrt_console} root=PARTUUID=${wrt_root} rw rootwait
		panic=5 watchdog.open_timeout=90 wrt.slot=${boot_slot}
		fstools_overlay_compression_type=zstd;
	if load mmc ${wrt_mmc}:${wrt_bp} ${kernel_addr_r} kernel.img; then
		run wrt_bootos;
	fi;
	run wrt_fallback

/* The slot did not start: try the other one once in this power cycle, then stop. */
wrt_fallback=
	if test -z "${wrt_tried}"; then
		setenv wrt_tried 1; run wrt_other; run wrt_boot;
	else
		echo wrt: neither slot boots, stopping at the prompt;
	fi

/* The trial slot never got confirmed: go back to the other slot for good. */
wrt_rollback=
	run wrt_other;
	setenv upgrade_available 0; setenv bootcount 0; saveenv;
	run wrt_boot

wrt_other=
	if test "${boot_slot}" = b; then setenv boot_slot a; else setenv boot_slot b; fi
