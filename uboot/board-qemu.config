# Emulator: the environment on the SD card (sdhci-pci) where the R4S keeps it,
# and the commands board-qemu.env unpacks the kernel with.
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_ENV_OFFSET=0x3F8000
CONFIG_ENV_SIZE=0x8000
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_PCI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FDT=y
CONFIG_LZMA=y
CONFIG_CMD_LZMADEC=y
