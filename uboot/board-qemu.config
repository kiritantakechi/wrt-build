# Emulator: the environment on the boot disk, which sdhci-pci makes mmc0, and not
# in flash; and the commands board-qemu.env unpacks the kernel with.
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_PCI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FDT=y
CONFIG_LZMA=y
CONFIG_CMD_LZMADEC=y
