/*
 * Emulator, on top of the stock QEMU environment (memory layout, consoles). The
 * boot disk (sdhci-pci) is mmc0, the console the PL011 at 0x9000000. The FIT
 * loads its kernel at a RAM address of the boards, which is not RAM here, so the
 * kernel is checked and unpacked by hand and started with the device tree QEMU
 * gave U-Boot (foundation D14).
 */
#include "board/emulation/qemu-arm/qemu-arm.env"

wrt_mmc=0
wrt_console=console=ttyAMA0 earlycon=pl011,0x9000000
wrt_bootos=
	iminfo ${kernel_addr_r} &&
	fdt addr ${kernel_addr_r} &&
	fdt get addr wrt_kernel_lzma /images/kernel-1 data &&
	lzmadec ${wrt_kernel_lzma} 0x48000000 &&
	booti 0x48000000 - ${fdtcontroladdr}
