# A/B slot logic (design D3): the configuration every A/B U-Boot shares.
# bootcount lives in the environment and counts only while upgrade_available=1.
CONFIG_BOOTCOUNT_LIMIT=y
# CONFIG_BOOTCOUNT_GENERIC is not set
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3
CONFIG_BOOTCOUNT_ALTBOOTCMD="run wrt_rollback"
# The default environment is board/<vendor>/<board>/wrt.env (wrt-ab.mk), and the
# stored one may set only the slot logic's state: the variables the static flags
# list marks writable (w), each with its type.
CONFIG_ENV_SOURCE_FILE="wrt"
CONFIG_ENV_WRITEABLE_LIST=y
CONFIG_ENV_FLAGS_LIST_STATIC="boot_slot:sw,bootcount:dw,upgrade_available:dw"
# The stored environment sits at one place on every boot disk (board-model D3),
# between the loader and the U-Boot FIT, and nowhere else; board-<id>.config
# names the disk's MMC device. U-Boot applies each fragment on its own, asking
# for what it leaves unset, so this one enables MMC for the location to depend
# on (the emulator's defconfig has none) and turns off the flash the emulator's
# defconfig keeps it in, where a second copy would want an address of its own.
CONFIG_MMC=y
CONFIG_ENV_IS_IN_MMC=y
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_OFFSET=0x3F8000
CONFIG_ENV_SIZE=0x8000
# Two copies: a write replaces the older one, so a write cut short leaves the
# previous state (trial-boot-resilience D1). The second follows the first in the
# free space before u-boot.itb, which leaves the loader its room below the first.
# wrt_boot names both to Linux (wrt-ab.env).
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET_REDUND=0x400000
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run wrt_boot"
# wrt_boot names the root by its partition UUID.
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
