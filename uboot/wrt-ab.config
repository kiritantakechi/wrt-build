# A/B slot logic (design D3): the configuration every A/B U-Boot shares.
# bootcount lives in the environment and counts only while upgrade_available=1.
CONFIG_BOOTCOUNT_LIMIT=y
# CONFIG_BOOTCOUNT_GENERIC is not set
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3
CONFIG_BOOTCOUNT_ALTBOOTCMD="run wrt_rollback"
# The default environment is board/<vendor>/<board>/wrt.env (wrt-ab.mk), and the
# stored one may set only the variables of WRT_AB_WRITEABLE.
CONFIG_ENV_SOURCE_FILE="wrt"
CONFIG_ENV_WRITEABLE_LIST=y
# The stored environment sits at one place on every boot disk (board-model D3),
# between the loader and the U-Boot FIT; board-<id>.config names the disk's MMC
# device. U-Boot applies each fragment on its own, so this one enables MMC for
# the location to depend on: the emulator's defconfig has none.
CONFIG_MMC=y
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_OFFSET=0x3F8000
CONFIG_ENV_SIZE=0x8000
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run wrt_boot"
# wrt_boot names the root by its partition UUID.
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
