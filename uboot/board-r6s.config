# NanoPi R6S: the environment on the eMMC, mmc1 (U-Boot takes it from the MMC
# device it booted from, and this index only when it cannot tell), and U-Boot
# starts the DesignWare watchdog, which runs on into Linux.
CONFIG_ENV_MMC_DEVICE_INDEX=1
CONFIG_WDT=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=60000
CONFIG_DESIGNWARE_WATCHDOG=y
