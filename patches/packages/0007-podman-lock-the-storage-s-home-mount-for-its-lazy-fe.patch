+ 		}
+ 	}
+@@ -445,6 +466,7 @@ func Init(home string, options graphdriver.Options) (graphdriver.Driver, error)
+ 		options:               *opts,
+ 		stagingDirsLocksMutex: sync.Mutex{},
+ 		stagingDirsLocks:      make(map[string]*staging_lockfile.StagingLockFile),
++		homeLock:              homeLock,
