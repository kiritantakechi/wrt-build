+ 
+ 	d.naiveDiff = graphdriver.NewNaiveDiffDriver(d, graphdriver.NewNaiveLayerIDMapUpdater(d))
+@@ -863,6 +885,8 @@ func (d *Driver) Cleanup() error {
+ 	if anyPresent {
+ 		return nil
+ 	}
++	d.homeLock.Lock()
++	defer d.homeLock.Unlock()
+ 	return mount.Unmount(d.home)
+ }
+ 
+@@ -2672,7 +2696,9 @@ func (d *Driver) supportsIDmappedMounts() bool {
+ 		return *d.supportsIDMappedMounts
+ 	}
+ 
++	d.homeLock.Lock()
+ 	supportsIDMappedMounts, err := checkAndRecordIDMappedSupport(d.home, d.runhome)
++	d.homeLock.Unlock()
+ 	d.supportsIDMappedMounts = &supportsIDMappedMounts
+ 	if err == nil {
+ 		return supportsIDMappedMounts
