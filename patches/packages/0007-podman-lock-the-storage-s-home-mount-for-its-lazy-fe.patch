+++ b/utils/podman/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=podman
 PKG_VERSION:=5.8.4
-PKG_RELEASE:=4
+PKG_RELEASE:=5
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://github.com/podman-container-tools/podman/archive/v$(PKG_VERSION)
diff --git a/utils/podman/patches/021-overlay-lock-home-s-mount-for-the-lazy-feature-probes.patch b/utils/podman/patches/021-overlay-lock-home-s-mount-for-the-lazy-feature-probes.patch
new file mode 100644
