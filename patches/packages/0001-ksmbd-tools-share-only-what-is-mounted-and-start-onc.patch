From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Tue, 29 Sep 2026 13:30:00 +0800
Subject: [PATCH] ksmbd-tools: share only what is mounted, and start once it is

A share whose path lies on an fstab mount point that is not mounted
exposed the directory underneath, on the root filesystem: files written
there filled the flash, and vanished from view once the disk came. A
share whose disk was unmounted while ksmbd ran stayed offered until the
service restarted.

Leave such a share out until its mount point is mounted, and reload the
service when it is mounted or unmounted: a mount trigger and an unmount
trigger per share, the latter from procd.sh's unmount helpers. The
unmount trigger comes while the mount point is still mounted, before
the unmount, and names it: the shares on it are left out at once. A
share counts as mounted only while every mount point that holds it is
(procd_mountpoints_mounted). A reload starts the service anew, as
start_service resets the server hard; a restart would drop the service,
and its triggers with it, until it has started again, so a disk that
comes back while the service restarts would go unnoticed. With every
share waiting for its mount, stop a running server and start nothing.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Pending
---
 net/ksmbd-tools/Makefile         |  2 +-
 net/ksmbd-tools/files/ksmbd.init | 37 ++++++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/net/ksmbd-tools/Makefile b/net/ksmbd-tools/Makefile
index df3a142..080ffc4 100644
--- a/net/ksmbd-tools/Makefile
+++ b/net/ksmbd-tools/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=ksmbd-tools
 PKG_VERSION:=3.5.7
-PKG_RELEASE:=1
+PKG_RELEASE:=3
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://github.com/cifsd-team/ksmbd-tools/releases/download/$(PKG_VERSION)
diff --git a/net/ksmbd-tools/files/ksmbd.init b/net/ksmbd-tools/files/ksmbd.init
index f87b392..b080fde 100644
--- a/net/ksmbd-tools/files/ksmbd.init
+++ b/net/ksmbd-tools/files/ksmbd.init
@@ -109,6 +109,17 @@ smb_add_share()
 
 	[ -z "$name" ] || [ -z "$path" ] && return
 
+	# A share on a mount point that is not mounted, or that is being unmounted,
+	# would expose the directory underneath (on the root filesystem): leave it
+	# out until it is mounted.
+	if ! procd_mountpoints_mounted "$path" ||
+		{ [ -n "$UNMOUNTING" ] && procd_get_mountpoints "$path" | grep -qxF "$UNMOUNTING"; }; then
+		logger -p daemon.info -t 'ksmbd' "Share $name waits for its mount point to be mounted."
+		SHARES_WAITING=$((SHARES_WAITING + 1))
+		return
+	fi
+	SHARES=$((SHARES + 1))
+
 	{
 		printf "\n[%s]\n\tpath = %s\n" "$name" "$path"
 		[ -n "$comment" ] && printf "\tcomment = %s\n" "$comment"
@@ -142,6 +153,8 @@ smb_add_share()
 
 init_config()
 {
+	SHARES=0
+	SHARES_WAITING=0
 	mkdir -p /var/etc/ksmbd
 
 	config_load ksmbd
@@ -150,12 +163,26 @@ init_config()
 	config_foreach smb_add_share share
 }
 
+smb_add_share_trigger()
+{
+	local path
+	config_get path "$1" path
+	[ -n "$path" ] || return
+	# Reload, which starts the service anew, rather than restart: a restart
+	# drops the service, triggers and all, until it has started again.
+	procd_add_reload_mount_trigger "$path"
+	procd_add_reload_unmount_trigger "$path"
+}
+
 service_triggers()
 {
 	# PROCD_RELOAD_DELAY=1000
 
 	procd_add_reload_trigger "dhcp" "system" "ksmbd"
 
+	config_load ksmbd
+	config_foreach smb_add_share_trigger share
+
 	for i in $SMBD_IFACE; do
 		procd_add_reload_interface_trigger "$i"
 	done
@@ -173,6 +200,10 @@ kill_server()
 
 start_service()
 {
+	# Reloaded by an unmount trigger: "unmounting <mountpoint>", which is still
+	# mounted while the unmount waits for this.
+	UNMOUNTING=
+	[ "$1" = unmounting ] && UNMOUNTING="$2"
 	init_config
 
 	if [ ! -e /etc/ksmbd/ksmbd.conf ]; then
@@ -182,6 +213,12 @@ start_service()
 	
 	# NOTE: We don't do a soft-reload via signal, since [global] ksmbd.conf setting changes will be ignored, so always reset hard.
 	[ -e /sys/module/ksmbd ] && stop_service
+
+	# Every share waits for its mount: nothing to serve.
+	if [ "$SHARES" -eq 0 ] && [ "$SHARES_WAITING" -gt 0 ]; then
+		logger -p daemon.notice -t 'ksmbd' "No share is mounted, not starting."
+		return 0
+	fi
 	
 	[ ! -e /sys/module/ksmbd ] && modprobe ksmbd 2> /dev/null
 	if [ ! -e /sys/module/ksmbd ]; then
