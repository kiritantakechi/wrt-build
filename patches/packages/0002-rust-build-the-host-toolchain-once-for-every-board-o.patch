From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Sat, 3 Oct 2026 22:17:18 +0800
Subject: [PATCH] rust: build the host toolchain once for every board of an
 architecture

rust/host builds the compiler, and the standard library for the target,
in the target's build directory, and installs them into the target's
staging directory. A tree that builds several boards of one
architecture, each in directories of its own (CONFIG_BUILD_SUFFIX),
thus builds the same toolchain once per board, LLVM included, about two
hours each, and keeps a build directory of 21 GB per board. Build and
install it as every other host package, in build_dir/hostpkg and
staging_dir/hostpkg, where package builds find cargo and rustc on their
PATH.

Most of the time goes into LLVM, which is built for every backend it
has. rustc needs only the host's, for build scripts and procedural
macros, and the target's: build these two, or every backend as before
when either is not known. With CONFIG_CCACHE, LLVM's C++ goes through
ccache.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Inappropriate [every board of this tree shares one architecture]
---
 lang/rust/Makefile | 37 ++++++++++++++++++++++++++++---------
 1 file changed, 28 insertions(+), 9 deletions(-)

diff --git a/lang/rust/Makefile b/lang/rust/Makefile
index 2a01fb6..4d17ff6 100644
--- a/lang/rust/Makefile
+++ b/lang/rust/Makefile
@@ -11,7 +11,7 @@ PKG_RELEASE:=2
 PKG_SOURCE:=rustc-$(PKG_VERSION)-src.tar.xz
 PKG_SOURCE_URL:=https://static.rust-lang.org/dist/
 PKG_HASH:=b99ce16cdf0ecfc761b585ac84d131b46733465a02f8ecd0ff2de9713c62ee09
-HOST_BUILD_DIR:=$(BUILD_DIR)/host/rustc-$(PKG_VERSION)-src
+HOST_BUILD_DIR:=$(BUILD_DIR_HOST)/rustc-$(PKG_VERSION)-src
 
 PKG_MAINTAINER:=Luca Barbato <lu_zero@luminem.org>
 PKG_LICENSE:=Apache-2.0 MIT
@@ -45,7 +45,7 @@ define Package/rust/config
 endef
 
 # Rust-lang has an uninstall script
-RUST_UNINSTALL:=$(STAGING_DIR)/host/lib/rustlib/uninstall.sh
+RUST_UNINSTALL:=$(STAGING_DIR_HOSTPKG)/lib/rustlib/uninstall.sh
 
 # Target Flags
 TARGET_CONFIGURE_ARGS = \
@@ -60,23 +60,42 @@ TARGET_CONFIGURE_ARGS = \
 # CARGO_HOME is an environmental
 HOST_CONFIGURE_VARS += CARGO_HOME="$(CARGO_HOME)"
 
+# The host toolchain, with the standard library for the target, is built once
+# for every target of the same architecture and shared like any host package,
+# in build_dir/hostpkg and staging_dir/hostpkg. Its LLVM has the backends of
+# the host, for build scripts and procedural macros, and of the target only.
+rust_llvm_target=$(strip \
+  $(if $(filter aarch64%,$(1)),AArch64, \
+  $(if $(filter x86_64 i386 i486 i586 i686,$(1)),X86, \
+  $(if $(filter arm%,$(1)),ARM, \
+  $(if $(filter mips%,$(1)),Mips, \
+  $(if $(filter powerpc%,$(1)),PowerPC, \
+  $(if $(filter riscv%,$(1)),RISCV, \
+  $(if $(filter loongarch%,$(1)),LoongArch))))))))
+# Built for every backend, as upstream does, when one of the two is not known.
+RUST_LLVM_HOST:=$(call rust_llvm_target,$(HOST_ARCH))
+RUST_LLVM_TARGET:=$(call rust_llvm_target,$(ARCH))
+RUST_LLVM_TARGETS:=$(if $(and $(RUST_LLVM_HOST),$(RUST_LLVM_TARGET)),$(subst $(space),;,$(sort $(RUST_LLVM_HOST) $(RUST_LLVM_TARGET))))
+
 # Rust Configuration Arguments
 HOST_CONFIGURE_ARGS = \
 	--build=$(RUSTC_HOST_ARCH) \
 	--target=$(RUSTC_TARGET_ARCH),$(RUSTC_HOST_ARCH) \
 	--host=$(RUSTC_HOST_ARCH) \
-	--prefix=$(STAGING_DIR)/host \
-	--bindir=$(STAGING_DIR)/host/bin \
-	--libdir=$(STAGING_DIR)/host/lib \
-	--sysconfdir=$(STAGING_DIR)/host/etc \
-	--datadir=$(STAGING_DIR)/host/share \
-	--mandir=$(STAGING_DIR)/host/man \
+	--prefix=$(STAGING_DIR_HOSTPKG) \
+	--bindir=$(STAGING_DIR_HOSTPKG)/bin \
+	--libdir=$(STAGING_DIR_HOSTPKG)/lib \
+	--sysconfdir=$(STAGING_DIR_HOSTPKG)/etc \
+	--datadir=$(STAGING_DIR_HOSTPKG)/share \
+	--mandir=$(STAGING_DIR_HOSTPKG)/man \
 	--dist-compression-formats=gz \
 	--disable-sanitizers \
 	--release-channel=stable \
 	--enable-cargo-native-static \
 	--bootstrap-cache-path=$(DL_DIR)/rustc \
 	--set=llvm.download-ci-llvm=false \
+	$(if $(RUST_LLVM_TARGETS),'--set=llvm.targets=$(RUST_LLVM_TARGETS)' --set=llvm.experimental-targets=) \
+	$(if $(CONFIG_CCACHE),--set=llvm.ccache=$(STAGING_DIR_HOST)/bin/ccache) \
 	$(TARGET_CONFIGURE_ARGS)
 
 define Host/Uninstall
@@ -102,7 +121,7 @@ define Host/Install
 			$(STAGING_DIR_HOST)/bin/libdeflate-gzip -dc "$$$$targz" | tar -xf - ; \
 		done ; \
 		find . -mindepth 2 -maxdepth 2 -type f -name install.sh \
-			-execdir bash '{}' --prefix=$(STAGING_DIR)/host --disable-ldconfig \; ; \
+			-execdir bash '{}' --prefix=$(STAGING_DIR_HOSTPKG) --disable-ldconfig \; ; \
 	)
 endef
 
-- 
2.51.2

