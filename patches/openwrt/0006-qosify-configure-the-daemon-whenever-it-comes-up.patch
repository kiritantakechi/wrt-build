From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Tue, 29 Sep 2026 06:30:00 +0800
Subject: [PATCH] qosify: configure the daemon whenever it comes up

service_running waited 10 seconds for the daemon's ubus object and, if
it had not appeared by then, left qosify unconfigured until the next
reload: no shaping and no classification, with only a "Request timed
out" in the log. The daemon registers once its BPF programs are loaded,
which on a busy boot can take far longer than that.

Wait in the background instead, so that the boot does not wait along,
and for as long as procd runs the daemon; then configure it.

service_running still tells whether procd runs the daemon, as the
running action expects.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Pending
---
 package/network/config/qosify/Makefile          |  2 +-
 package/network/config/qosify/files/qosify.init | 12 ++++++++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/package/network/config/qosify/Makefile b/package/network/config/qosify/Makefile
index c6b4b94..cb07bc2 100644
--- a/package/network/config/qosify/Makefile
+++ b/package/network/config/qosify/Makefile
@@ -14,7 +14,7 @@ PKG_SOURCE_PROTO:=git
 PKG_SOURCE_DATE:=2026-10-14
 PKG_SOURCE_VERSION:=b3ee50eff9d924a6c7a0c02b9ab1afc6056b7a00
 PKG_MIRROR_HASH:=924dd93cfc3205da58127bbd0397322e0b48819be28db3538e6ab9fc6196c536
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_LICENSE:=GPL-2.0
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/qosify/files/qosify.init b/package/network/config/qosify/files/qosify.init
index 9bff6be..737a474 100644
--- a/package/network/config/qosify/files/qosify.init
+++ b/package/network/config/qosify/files/qosify.init
@@ -167,6 +167,14 @@ start_service() {
 }
 
 service_running() {
-	ubus -t 10 wait_for qosify
-	[ $? = 0 ] && reload_service
+	# The daemon appears on ubus once its BPF programs are loaded, which can
+	# take minutes on a busy boot. Configure it once it is up, without holding
+	# up the boot meanwhile, as long as procd runs it.
+	(
+		until ubus -t 30 wait_for qosify; do
+			procd_running qosify || exit 0
+		done
+		reload_service
+	) >/dev/null 2>&1 &
+	procd_running qosify
 }
