From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Sun, 4 Oct 2026 02:54:18 +0800
Subject: [PATCH] kernel: keep the modules pass up to date past the image pass

Kernel/Make skips kbuild when its command line is the one of its last
run and no file of the kernel tree is newer than that run's stamp. The
image pass runs after the modules pass and writes vmlinux.symvers, which
modpost writes whenever it links vmlinux alone. The next build's modules
pass finds that file newer than its stamp, runs kbuild, removes vmlinux
and System.map and so links vmlinux again, BTF included, and the image
pass then runs again in turn. So no build skips kbuild, and each one
links the kernel again: six minutes on an arm64 host with BTF.

The image pass builds on what the modules pass built and changes none
of its inputs, so a modules pass that was up to date before the image
pass still is after it: refresh its stamp then. Any file newer than the
stamp before the image pass, such as a module's source edited before
only the image is built, leaves the stamp as it is, for the next modules
pass to build. The scan that Kernel/Make skips by, now Kernel/Newer,
tells which.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Pending
---
 include/kernel-defaults.mk | 21 ++++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/include/kernel-defaults.mk b/include/kernel-defaults.mk
index c0449ef..dfe269b 100644
--- a/include/kernel-defaults.mk
+++ b/include/kernel-defaults.mk
@@ -141,20 +141,23 @@ endef
 # changes it without a change in the kernel tree.
 KERNEL_MAKE_DEPENDS_image := $(if $(CONFIG_STRIP_KERNEL_EXPORTS),$(KERNEL_BUILD_DIR)/symtab.h)
 
+# $(1): stamp name
+# Print the first file in the kernel tree, the toolchain or the stamp's other
+# inputs that is newer than the stamp. The build system files at the top of
+# the kernel tree are not inputs of kbuild, apart from .config.
+Kernel/Newer = find $(LINUX_DIR) $(TOOLCHAIN_DIR)/bin $(KERNEL_MAKE_DEPENDS_$(1)) \
+	\( -path '$(LINUX_DIR)/.*' ! -path '$(LINUX_DIR)/.config' \) -prune -o \
+	! -type d -newer $(LINUX_DIR)/.kbuild_$(1) -print -quit
+
 # $(1): stamp name, $(2): make targets and options, $(3): commands to run before kbuild
 # kbuild takes about half a second even if nothing changed, and runs twice
 # per build. Skip it if the command line did not change since its last
 # successful run, and no file in the kernel tree or the toolchain is newer.
-# The build system files at the top of the kernel tree are not inputs of
-# kbuild, apart from .config.
 define Kernel/Make
 	{ \
 		stamp=$(LINUX_DIR)/.kbuild_$(1); \
 		key="$$$$(printf '%s' '$(subst ','\'',$(KERNEL_MAKE) $(2))' | $(MKHASH) md5)"; \
-		[ "$$$$(cat $$$$stamp 2>/dev/null)" = "$$$$key" ] && [ -z "$$$$(find $(LINUX_DIR) $(TOOLCHAIN_DIR)/bin \
-			$(KERNEL_MAKE_DEPENDS_$(1)) \
-			\( -path '$(LINUX_DIR)/.*' ! -path '$(LINUX_DIR)/.config' \) -prune -o \
-			! -type d -newer $$$$stamp -print -quit)" ] || { \
+		[ "$$$$(cat $$$$stamp 2>/dev/null)" = "$$$$key" ] && [ -z "$$$$($(call Kernel/Newer,$(1)))" ] || { \
 			rm -f $$$$stamp; \
 			$(3) \
 			$(KERNEL_MAKE) $(2) && echo "$$$$key" > $$$$stamp; \
@@ -194,7 +197,11 @@ endef
 
 define Kernel/CompileImage/Default
 	rm -f $(TARGET_DIR)/init
-	+$(call Kernel/Make,image,$(KERNEL_MAKEOPTS_IMAGE) $(if $(KERNELNAME),$(KERNELNAME),all))
+	# The image pass writes vmlinux.symvers, but changes none of the inputs
+	# of the modules pass: if that pass was up to date, it still is.
+	+modules_stale="$$$$([ -f $(LINUX_DIR)/.kbuild_modules ] && $(call Kernel/Newer,modules) || echo no stamp)"; \
+	$(call Kernel/Make,image,$(KERNEL_MAKEOPTS_IMAGE) $(if $(KERNELNAME),$(KERNELNAME),all)) && \
+	{ [ -n "$$$$modules_stale" ] || touch $(LINUX_DIR)/.kbuild_modules; }
 	$(call Kernel/CopyImage)
 endef
 
