From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Mon, 28 Sep 2026 23:55:25 +0800
Subject: [PATCH] uboot-envtools: rockchip: add NanoPi R4S

The NanoPi R4S keeps its U-Boot environment on the SD card at 0x3f8000,
0x8000 bytes long, as its defconfig sets. The card is found through the
root partition rather than by a fixed name.
---
 .../boot/uboot-tools/uboot-envtools/files/rockchip_armv8    | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/package/boot/uboot-tools/uboot-envtools/files/rockchip_armv8 b/package/boot/uboot-tools/uboot-envtools/files/rockchip_armv8
index 075776a..e57665f 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/rockchip_armv8
+++ b/package/boot/uboot-tools/uboot-envtools/files/rockchip_armv8
@@ -11,6 +11,12 @@ touch /etc/config/ubootenv
 board=$(board_name)
 
 case "$board" in
+friendlyarm,nanopi-r4s|\
+friendlyarm,nanopi-r4s-enterprise)
+	. /lib/upgrade/common.sh
+	export_bootdevice && export_partdevice bootdisk 0 && \
+		ubootenv_add_uci_config "/dev/$bootdisk" "0x3f8000" "0x8000"
+	;;
 xunlong,orangepi-r1-plus|\
 xunlong,orangepi-r1-plus-lts)
 	ubootenv_add_uci_config "/dev/mmcblk0" "0x3f8000" "0x8000"
