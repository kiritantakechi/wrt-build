From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Sun, 18 Oct 2026 18:57:14 +0800
Subject: [PATCH] uboot-rockchip: merge configuration fragments without asking

U-Boot merges each configuration fragment by piping `yes ""` into
`make oldconfig`, which asks a hex or int symbol without a default
again on every empty answer: a fragment that brings one up for a later
fragment to settle makes the build wait for ever, and its log of the
question grows without end. Turning on a second environment copy on a
defconfig that keeps the environment in flash does it.

Carry the U-Boot patch that runs olddefconfig after the merge, as Linux
does since 3266c806dc86. It is meant for U-Boot upstream.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Pending
---
 package/boot/uboot-rockchip/Makefile          |  2 +-
 ...olddefconfig-after-merging-fragments.patch | 35 +++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)
 create mode 100644 package/boot/uboot-rockchip/patches/120-kconfig-run-olddefconfig-after-merging-fragments.patch

diff --git a/package/boot/uboot-rockchip/Makefile b/package/boot/uboot-rockchip/Makefile
index 8b38de5..e07a746 100644
--- a/package/boot/uboot-rockchip/Makefile
+++ b/package/boot/uboot-rockchip/Makefile
@@ -6,7 +6,7 @@ include $(TOPDIR)/rules.mk
 include $(INCLUDE_DIR)/kernel.mk
 
 PKG_VERSION:=2026.07
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 PKG_HASH:=78e8bfc382fe388f9b55aa1daf8c563522a037779b5d4c349d1415e381f1243e
 
 PKG_MAINTAINER:=Sarah Maedel <openwrt@tbspace.de>
diff --git a/package/boot/uboot-rockchip/patches/120-kconfig-run-olddefconfig-after-merging-fragments.patch b/package/boot/uboot-rockchip/patches/120-kconfig-run-olddefconfig-after-merging-fragments.patch
new file mode 100644
index 0000000..0be4605
--- /dev/null
+++ b/package/boot/uboot-rockchip/patches/120-kconfig-run-olddefconfig-after-merging-fragments.patch
@@ -0,0 +1,35 @@
+From: kiritantakechi <kiritantakechi@gmail.com>
+Subject: [PATCH] kconfig: run olddefconfig instead of oldconfig after merging
+ fragments
+
+The %.config rule merges a configuration fragment and then pipes
+`yes ""` into `make oldconfig`. An empty answer takes a symbol's
+default; a hex, int or string symbol without one is asked again, so a
+fragment that brings up such a symbol, for another fragment to settle,
+makes the merge ask for ever. A defconfig with CONFIG_ENV_IS_IN_FLASH
+and a fragment with CONFIG_ENV_REDUNDANT=y do it: ENV_ADDR_REDUND has no
+default, and `make qemu_arm64_defconfig redundant.config` never ends.
+
+Linux made the same change in commit 3266c806dc86 ("kconfig: run
+olddefconfig instead of oldconfig after merging fragments"):
+'make olddefconfig' is non-interactive and gives the same result wherever
+a default exists; a symbol without one stays unset.
+
+Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
+---
+ scripts/kconfig/Makefile | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/scripts/kconfig/Makefile b/scripts/kconfig/Makefile
+index abc34f6..53c1b43 100644
+--- a/scripts/kconfig/Makefile
++++ b/scripts/kconfig/Makefile
+@@ -108,7 +108,7 @@ configfiles=$(wildcard $(srctree)/kernel/configs/$@ \
+ %.config: $(obj)/conf
+ 	$(if $(call configfiles),, $(error No configuration exists for this target on this architecture))
+ 	$(Q)$(CONFIG_SHELL) $(srctree)/scripts/kconfig/merge_config.sh -m .config $(configfiles)
+-	+$(Q)yes "" | $(MAKE) -f $(srctree)/Makefile oldconfig
++	$(Q)$(MAKE) -f $(srctree)/Makefile olddefconfig
+ 
+ PHONY += kvmconfig
+ kvmconfig: kvm_guest.config
