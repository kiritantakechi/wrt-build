++/*
++ * Attach the classifier of one direction to iface's device: as a tcx link,
++ * after every program attached there, or, when tcx is off or the kernel has
++ * none, as a cls_bpf filter under clsact, which runs after all tcx programs.
++ * The links belong to the process: they go when it does, however it ends.
++ */
++static int
++interface_attach(struct qosify_iface *iface, bool egress, bool eth)
++{
++	LIBBPF_OPTS(bpf_link_create_opts, opts, .flags = BPF_F_AFTER);
++	char buf[64];
++	int prog_fd;
++	int fd;
++
++	if (tcx_enabled) {
++		if (!qosify_get_program(!egress * QOSIFY_INGRESS + !eth * QOSIFY_IP_ONLY, &prog_fd))
++			return -1;
++
++		fd = bpf_link_create(prog_fd, iface->ifindex,
++				     egress ? BPF_TCX_EGRESS : BPF_TCX_INGRESS, &opts);
++		if (fd >= 0) {
++			iface->links[egress] = fd;
++			return 0;
++		}
++
++		if (fd != -EINVAL && fd != -EOPNOTSUPP) {
++			ULOG_ERR("failed to attach to %s: %s\n", iface->ifname, strerror(-fd));
++			return -1;
++		}
