++ * one. An ifb takes link-layer frames: an IP-only device's packet first gets an
++ * Ethernet header, which the ifb strips again as it returns the packet.
++ */
++static __always_inline int
++redirect_ingress(struct __sk_buff *skb)
++{
++	struct ethhdr eth = {
++		.h_proto = (__be16)skb->protocol,
++	};
++	__u32 key = skb->ifindex;
++	__u32 *ifb, ifindex;
++
++	ifb = bpf_map_lookup_elem(&ingress_ifb, &key);
++	if (!ifb)
++		return TC_ACT_UNSPEC;
++
++	ifindex = *ifb;
++	if ((module_flags & QOSIFY_IP_ONLY) &&
++	    (bpf_skb_change_head(skb, sizeof(eth), 0) ||
++	     bpf_skb_store_bytes(skb, 0, &eth, sizeof(eth), 0)))
++		return TC_ACT_UNSPEC;
++
++	return bpf_redirect(ifindex, 0);
++}
