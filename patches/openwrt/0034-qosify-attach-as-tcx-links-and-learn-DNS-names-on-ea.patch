index 0000000..7828488
--- /dev/null
+++ b/package/network/config/qosify/patches/102-dns-learn-from-a-packet-socket-on-each-device.patch
@@ -0,0 +1,444 @@
+From: kiritantakechi <kiritantakechi@gmail.com>
+Subject: [PATCH] dns: learn from a packet socket on each device
+
+qosify learnt DNS names from the replies that flower filters on each
+device's ingress redirected to ifb-dns, where a raw packet socket read
+them as Ethernet frames. The packets of a device without a link-layer
+header, such as pppoe-wan, reach ifb-dns without one: the parser took
+their IP header for an Ethernet header, and learnt nothing. The filters
+and ifb-dns stay behind when qosify is killed outright.
+
+Open a packet socket on each device qosify sets up instead. On an
+Ethernet device it is a raw socket, whose frames keep their Ethernet
+header: the header says whether a VLAN tag the kernel left in the
+packet, the inner tag of a double-tagged one, comes before the IP
+header. A datagram socket would report the protocol behind such a tag
+and keep the tag in the packet. On any other device, which has no VLAN
+tags, it is a datagram socket, whose packets start with their IP header
+whatever the link layer, and sll_protocol says which. Its classic BPF
+filter reads the packet from its network header on, and passes UDP from
+port 53, over IPv4 (not a later fragment) or IPv6, behind such a tag or
+not; PACKET_IGNORE_OUTGOING keeps out what the device sends. The socket
+gets a copy of each reply, which goes on untouched, and it goes with the
+device's setup and with the process. Its errors are read like packets:
+uloop would drop it on the first, ENETDOWN as its device goes down, and
+leave it unread once the device is up again.
+
+The IP header, behind an Ethernet header and a VLAN tag or not, stays
+four-byte aligned, as struct ip and struct ip6_hdr must be.
+
+Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
+---
+ dns.c       | 169 ++++++++++++++++++++++++++++++++++++----------------
+ interface.c |  56 ++---------------
+ qosify.h    |   5 +-
+ 3 files changed, 127 insertions(+), 103 deletions(-)
+
+diff --git a/dns.c b/dns.c
+index 2a7167d..5b2fa51 100644
+--- a/dns.c
++++ b/dns.c
+@@ -1,10 +1,10 @@
++#include <linux/filter.h>
+ #include <netinet/if_ether.h>
+ #include <netinet/in.h>
+ #include <netinet/ip.h>
+ #include <netinet/ip6.h>
+ #include <netinet/udp.h>
+ #include <netpacket/packet.h>
+-#include <net/if.h>
+ #include <sys/socket.h>
+ #include <sys/types.h>
+ #include <errno.h>
+@@ -37,7 +37,6 @@
+ 
+ #include "qosify.h"
+ 
+-static struct uloop_fd ufd;
+ static struct uloop_timeout cname_gc_timer;
+ static AVL_TREE(cname_cache, avl_strcmp, false, NULL);
+ 
+@@ -279,18 +278,11 @@ qosify_dns_data_cb(struct packet *pkt)
+ }
+ 
+ static void
+-qosify_dns_packet_cb(struct packet *pkt)
++qosify_dns_packet_cb(struct packet *pkt, uint16_t proto)
+ {
+-	struct ethhdr *eth;
+ 	struct ip6_hdr *ip6;
+ 	struct ip *ip;
+-	uint16_t proto;
+-
+-	eth = pkt_pull(pkt, sizeof(*eth));
+-	if (!eth)
+-		return;
+ 
+-	proto = be16_to_cpu(eth->h_proto);
+ 	if (proto_is_vlan(proto)) {
+ 		struct vlan_hdr *vlan;
+ 
+@@ -333,21 +325,28 @@ qosify_dns_packet_cb(struct packet *pkt)
+ }
+ 
+ static void
+-qosify_dns_socket_cb(struct uloop_fd *fd, unsigned int events)
++qosify_dns_recv(struct uloop_fd *fd, bool eth)
+ {
+ 	/*
+-	 * Received two bytes into a four-byte aligned buffer, as NET_IP_ALIGN
+-	 * does: the IP header after the Ethernet header, and after a VLAN tag,
+-	 * is then four-byte aligned, as struct ip and struct ip6_hdr must be.
++	 * Received into a four-byte aligned buffer, two bytes in for a frame
++	 * with an Ethernet header, as NET_IP_ALIGN does: the IP header, behind
++	 * a VLAN tag or not, is then four-byte aligned, as struct ip and
++	 * struct ip6_hdr must be.
+ 	 */
+ 	static uint8_t buf[2 + 8192] __attribute__((aligned(4)));
++	unsigned int ofs = eth ? 2 : 0;
+ 	struct packet pkt = {
+-		.buffer = buf + 2,
++		.buffer = buf + ofs,
+ 	};
++	struct sockaddr_ll sll;
++	socklen_t sll_len = sizeof(sll);
++	struct ethhdr *ethh;
++	uint16_t proto;
+ 	int len;
+ 
+ retry:
+-	len = recvfrom(fd->fd, buf + 2, sizeof(buf) - 2, MSG_DONTWAIT, NULL, NULL);
++	len = recvfrom(fd->fd, buf + ofs, sizeof(buf) - ofs, MSG_DONTWAIT,
++		       (struct sockaddr *)&sll, &sll_len);
+ 	if (len < 0) {
+ 		if (errno == EINTR)
+ 			goto retry;
+@@ -358,7 +357,28 @@ retry:
+ 		return;
+ 
+ 	pkt.len = len;
+-	qosify_dns_packet_cb(&pkt);
++	proto = be16_to_cpu(sll.sll_protocol);
++	if (eth) {
++		ethh = pkt_pull(&pkt, sizeof(*ethh));
++		if (!ethh)
++			return;
++
++		proto = be16_to_cpu(ethh->h_proto);
++	}
++
++	qosify_dns_packet_cb(&pkt, proto);
++}
++
++static void
++qosify_dns_eth_cb(struct uloop_fd *fd, unsigned int events)
++{
++	qosify_dns_recv(fd, true);
++}
++
++static void
++qosify_dns_ip_cb(struct uloop_fd *fd, unsigned int events)
++{
++	qosify_dns_recv(fd, false);
+ }
+ 
+ static void
+@@ -378,43 +398,104 @@ qosify_cname_cache_gc(struct uloop_timeout *timeout)
+ 	uloop_timeout_set(timeout, 1000);
+ }
+ 
+-static int
+-qosify_open_dns_socket(void)
++/* A filter's load from the packet's network header on */
++#define NET_OFF(ofs)	(SKF_NET_OFF + (int)(ofs))
++
++/*
++ * Learn from the DNS replies that reach the device ifindex: a packet socket on
++ * it gets a copy of each, while the reply itself goes on untouched. The kernel
++ * takes a packet's VLAN tag off before the socket sees it, and leaves the inner
++ * tag of a double-tagged one in the packet. On an Ethernet device, the socket
++ * gets the whole frame, whose Ethernet header says whether such a tag comes
++ * first; a datagram socket would report the protocol behind the tag and keep
++ * the tag. On any other device, which has no VLAN tags, it gets the packet from
++ * its IP header on. Its filter, which reads the packet from its network header
++ * on, passes UDP from port 53, over IPv4 (not a later fragment) or IPv6, behind
++ * such a tag or not, and nothing the device sends.
++ */
++int qosify_dns_open(struct uloop_fd *fd, unsigned int ifindex, bool eth)
+ {
++	static struct sock_filter code[] = {
++		/* X: where the IP header starts, behind a VLAN tag or not */
++		BPF_STMT(BPF_LD | BPF_W | BPF_ABS, SKF_AD_OFF + SKF_AD_PROTOCOL),
++		BPF_STMT(BPF_LDX | BPF_IMM, 0),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, ETH_P_8021Q, 1, 0),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, ETH_P_8021AD, 0, 2),
++		BPF_STMT(BPF_LD | BPF_H | BPF_ABS,
++			 NET_OFF(offsetof(struct vlan_hdr, proto))),
++		BPF_STMT(BPF_LDX | BPF_IMM, sizeof(struct vlan_hdr)),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, ETH_P_IPV6, 12, 0),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, ETH_P_IP, 0, 16),
++		/* IPv4: UDP, the first fragment, from port 53 */
++		BPF_STMT(BPF_LD | BPF_B | BPF_IND, NET_OFF(offsetof(struct ip, ip_p))),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, IPPROTO_UDP, 0, 14),
++		BPF_STMT(BPF_LD | BPF_H | BPF_IND, NET_OFF(offsetof(struct ip, ip_off))),
++		BPF_JUMP(BPF_JMP | BPF_JSET | BPF_K, IP_OFFMASK, 12, 0),
++		BPF_STMT(BPF_LD | BPF_B | BPF_IND, NET_OFF(0)),
++		BPF_STMT(BPF_ALU | BPF_AND | BPF_K, 0xf),
++		BPF_STMT(BPF_ALU | BPF_LSH | BPF_K, 2),
++		BPF_STMT(BPF_ALU | BPF_ADD | BPF_X, 0),
++		BPF_STMT(BPF_MISC | BPF_TAX, 0),
++		BPF_STMT(BPF_LD | BPF_H | BPF_IND,
++			 NET_OFF(offsetof(struct udphdr, uh_sport))),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 53, 4, 5),
++		/* IPv6: UDP from port 53 */
++		BPF_STMT(BPF_LD | BPF_B | BPF_IND, NET_OFF(offsetof(struct ip6_hdr, ip6_nxt))),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, IPPROTO_UDP, 0, 3),
++		BPF_STMT(BPF_LD | BPF_H | BPF_IND, NET_OFF(sizeof(struct ip6_hdr) +
++				 offsetof(struct udphdr, uh_sport))),
++		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 53, 0, 1),
++		BPF_STMT(BPF_RET | BPF_K, UINT32_MAX),
++		BPF_STMT(BPF_RET | BPF_K, 0),
++	};
++	struct sock_fprog prog = {
++		.len = ARRAY_SIZE(code),
++		.filter = code,
++	};
+ 	struct sockaddr_ll sll = {
+ 		.sll_family = AF_PACKET,
+ 		.sll_protocol = htons(ETH_P_ALL),
++		.sll_ifindex = ifindex,
+ 	};
++	int one = 1;
+ 	int sock;
+ 
+-	sock = socket(PF_PACKET, SOCK_RAW, htons(ETH_P_ALL));
+-	if (sock == -1) {
+-		ULOG_ERR("failed to create raw socket: %s\n", strerror(errno));
++	/* No protocol until bind(): nothing arrives before the filter is set. */
++	sock = socket(AF_PACKET, (eth ? SOCK_RAW : SOCK_DGRAM) | SOCK_CLOEXEC, 0);
++	if (sock < 0) {
++		ULOG_ERR("failed to create packet socket: %s\n", strerror(errno));
+ 		return -1;
+ 	}
+ 
+-	sll.sll_ifindex = if_nametoindex(QOSIFY_DNS_IFNAME);
+-	if (bind(sock, (struct sockaddr *)&sll, sizeof(sll))) {
+-		ULOG_ERR("failed to bind socket to "QOSIFY_DNS_IFNAME": %s\n",
+-			 strerror(errno));
+-		goto error;
++	if (setsockopt(sock, SOL_SOCKET, SO_ATTACH_FILTER, &prog, sizeof(prog)) ||
++	    setsockopt(sock, SOL_PACKET, PACKET_IGNORE_OUTGOING, &one, sizeof(one)) ||
++	    bind(sock, (struct sockaddr *)&sll, sizeof(sll))) {
++		ULOG_ERR("failed to set up the DNS socket on device %u: %s\n",
++			 ifindex, strerror(errno));
++		close(sock);
++		return -1;
+ 	}
+ 
+-	ufd.fd = sock;
+-	ufd.cb = qosify_dns_socket_cb;
+-	uloop_fd_add(&ufd, ULOOP_READ);
++	/*
++	 * Also on errors, which the callback reads like packets: uloop would
++	 * otherwise drop the socket when its device goes down (ENETDOWN), and
++	 * nothing would read it once the device is up again.
++	 */
++	fd->fd = sock;
++	fd->cb = eth ? qosify_dns_eth_cb : qosify_dns_ip_cb;
++	uloop_fd_add(fd, ULOOP_READ | ULOOP_ERROR_CB);
+ 
+ 	return 0;
+-
+-error:
+-	close(sock);
+-	return -1;
+ }
+ 
+-static void
+-qosify_dns_del_ifb(void)
++void qosify_dns_close(struct uloop_fd *fd)
+ {
+-	qosify_run_cmd("ip link del ifb-dns type ifb", true);
++	if (fd->fd < 0)
++		return;
++
++	uloop_fd_delete(fd);
++	close(fd->fd);
++	fd->fd = -1;
+ }
+ 
+ int qosify_dns_init(void)
+@@ -422,13 +503,6 @@ int qosify_dns_init(void)
+ 	cname_gc_timer.cb = qosify_cname_cache_gc;
+ 	qosify_cname_cache_gc(&cname_gc_timer);
+ 
+-	qosify_dns_del_ifb();
+-
+-	if (qosify_run_cmd("ip link add ifb-dns type ifb", false) ||
+-	    qosify_run_cmd("ip link set dev ifb-dns up", false) ||
+-	    qosify_open_dns_socket())
+-		return -1;
+-
+ 	return 0;
+ }
+ 
+@@ -436,13 +510,6 @@ void qosify_dns_stop(void)
+ {
+ 	struct cname_entry *e, *tmp;
+ 
+-	if (ufd.registered) {
+-		uloop_fd_delete(&ufd);
+-		close(ufd.fd);
+-	}
+-
+-	qosify_dns_del_ifb();
+-
+ 	avl_remove_all_elements(&cname_cache, e, node, tmp)
+ 		free(e);
+ 
+diff --git a/interface.c b/interface.c
+index 1cac143..7abd602 100644
+--- a/interface.c
++++ b/interface.c
+@@ -21,7 +21,6 @@
+ #include <linux/rtnetlink.h>
+ #include <linux/if_link.h>
+ #include <linux/pkt_cls.h>
+-#include <linux/tc_act/tc_mirred.h>
+ 
+ #include <libubox/vlist.h>
+ #include <libubox/avl-cmp.h>
+@@ -66,6 +65,8 @@ struct qosify_iface {
+ 	unsigned int ifindex;
+ 	bool active;
+ 
++	struct uloop_fd dns;
++
+ 	bool device;
+ 	struct blob_attr *config_data;
+ 	struct qosify_iface_config config;
+@@ -285,51 +286,6 @@ cmd_add_bpf_filter(const char *ifname, int prio, bool egress, bool eth)
+ 	return nl_wait_for_ack(rtnl_sock);
+ }
+ 
+-/*
+- * With protocol all, flower matches the protocol behind all VLAN tags, and
+- * the filters for IPv4 and IPv6 share one flow dissection per packet.
+- */
+-static int
+-cmd_add_dns_filter(const char *ifname, int prio, uint16_t eth_type)
+-{
+-	struct tc_mirred mirred = {
+-		.action = TC_ACT_STOLEN,
+-		.eaction = TCA_EGRESS_REDIR,
+-		.ifindex = if_nametoindex(QOSIFY_DNS_IFNAME),
+-	};
+-	struct nlattr *opts, *acts, *act, *act_opts;
+-	struct nl_msg *msg;
+-
+-	if (!mirred.ifindex)
+-		return -1;
+-
+-	msg = filter_msg_alloc(ifname, prio, false, "flower");
+-	if (!msg)
+-		return -1;
+-
+-	opts = nla_nest_start(msg, TCA_OPTIONS);
+-	nla_put_u16(msg, TCA_FLOWER_KEY_ETH_TYPE, htons(eth_type));
+-	nla_put_u8(msg, TCA_FLOWER_KEY_IP_PROTO, IPPROTO_UDP);
+-	nla_put_u16(msg, TCA_FLOWER_KEY_UDP_SRC, htons(53));
+-	nla_put_u32(msg, TCA_FLOWER_FLAGS, TCA_CLS_FLAGS_SKIP_HW);
+-
+-	acts = nla_nest_start(msg, TCA_FLOWER_ACT);
+-	act = nla_nest_start(msg, 1);
+-	nla_put_string(msg, TCA_ACT_KIND, "mirred");
+-	act_opts = nla_nest_start(msg, TCA_ACT_OPTIONS);
+-	nla_put(msg, TCA_MIRRED_PARMS, sizeof(mirred), &mirred);
+-	nla_nest_end(msg, act_opts);
+-	nla_nest_end(msg, act);
+-	nla_nest_end(msg, acts);
+-
+-	nla_nest_end(msg, opts);
+-
+-	nl_send_auto_complete(rtnl_sock, msg);
+-	nlmsg_free(msg);
+-
+-	return nl_wait_for_ack(rtnl_sock);
+-}
+-
+ static int
+ interface_queues(const char *ifname, const char *type)
+ {
+@@ -429,9 +385,6 @@ cmd_add_ingress(struct qosify_iface *iface, bool eth)
+ 
+ 	cmd_add_bpf_filter(iface->ifname, prio++, false, eth);
+ 
+-	cmd_add_dns_filter(iface->ifname, prio, ETH_P_IP);
+-	cmd_add_dns_filter(iface->ifname, prio++, ETH_P_IPV6);
+-
+ 	if (!iface->config.ingress)
+ 		return 0;
+ 
+@@ -474,7 +427,7 @@ interface_clear_qdisc(struct qosify_iface *iface)
+ 	prepare_qdisc_cmd(buf, sizeof(buf), iface->ifname, false, "root");
+ 	qosify_run_cmd(buf, true);
+ 
+-	for (i = 0; i < 6; i++) {
++	for (i = 0; i < 2; i++) {
+ 		prepare_filter_cmd(buf, sizeof(buf), iface->ifname, QOSIFY_PRIO_BASE + i, false, false);
+ 		qosify_run_cmd(buf, true);
+ 	}
+@@ -511,6 +464,7 @@ interface_start(struct qosify_iface *iface)
+ 	interface_clear_qdisc(iface);
+ 	cmd_add_egress(iface, eth);
+ 	cmd_add_ingress(iface, eth);
++	qosify_dns_open(&iface->dns, iface->ifindex, eth);
+ 
+ 	iface->active = true;
+ }
+@@ -524,6 +478,7 @@ interface_stop(struct qosify_iface *iface)
+ 	ULOG_INFO("stop interface %s\n", iface->ifname);
+ 	iface->active = false;
+ 
++	qosify_dns_close(&iface->dns);
+ 	interface_clear_qdisc(iface);
+ }
+ 
+@@ -588,6 +543,7 @@ interface_create(struct blob_attr *attr, bool device)
+ 	strcpy(name_buf, blobmsg_name(attr));
+ 	iface->config_data = attr;
+ 	iface->device = device;
++	iface->dns.fd = -1;
+ 	vlist_add(device ? &devices : &interfaces, &iface->node, name_buf);
+ }
+ 
+diff --git a/qosify.h b/qosify.h
+index cd904ee..eafd732 100644
+--- a/qosify.h
++++ b/qosify.h
+@@ -17,6 +17,7 @@
+ #include <libubox/avl.h>
+ #include <libubox/blobmsg.h>
+ #include <libubox/ulog.h>
++#include <libubox/uloop.h>
+ 
+ #include <netinet/in.h>
+ 
+@@ -24,8 +25,6 @@
+ #define CLASSIFY_PIN_PATH	"/sys/fs/bpf/qosify"
+ #define CLASSIFY_DATA_PATH	"/sys/fs/bpf/qosify_data"
+ 
+-#define QOSIFY_DNS_IFNAME "ifb-dns"
+-
+ #define QOSIFY_PRIO_BASE	0x110
+ 
+ enum qosify_map_id {
+@@ -118,6 +117,8 @@ void qosify_iface_stop(void);
+ 
+ int qosify_dns_init(void);
+ void qosify_dns_stop(void);
++int qosify_dns_open(struct uloop_fd *fd, unsigned int ifindex, bool eth);
++void qosify_dns_close(struct uloop_fd *fd);
+ void qosify_dns_get_stats(struct blob_buf *b, bool reset);
+ 
+ uint32_t qosify_map_get_ebpf_entry_count(void);
diff --git a/package/network/config/qosify/patches/103-interface-attach-the-classifiers-as-tcx-links.patch b/package/network/config/qosify/patches/103-interface-attach-the-classifiers-as-tcx-links.patch
new file mode 100644
index 0000000..3da5950
--- /dev/null
+++ b/package/network/config/qosify/patches/103-interface-attach-the-classifiers-as-tcx-links.patch
@@ -0,0 +1,495 @@
+From: kiritantakechi <kiritantakechi@gmail.com>
+Subject: [PATCH] interface: attach the classifiers as tcx links
+
+qosify attached its classifiers as cls_bpf filters under clsact, which
+the kernel runs after every tcx program on the device, and redirected
+the ingress to the interface's ifb with a mirred filter. Programs that
+attach as tcx links, such as einat's, ran first whatever either asked
+for, and a qosify killed outright left its filters behind.
+
+Attach the classifiers as tcx links with BPF_F_AFTER, after every
+program attached so far. A program that must run first asks for it
+with BPF_F_BEFORE, and the order holds whichever starts first. The
+links belong to the process, and go with it however it ends, or with
+the device.
+
+A tcx link has no name of its own, as a cls_bpf filter has, so the
+program's name is what tells qosify's apart from the others on the
+device: call it qosify_classify.
+
+The ingress classifier hands the packets to the ifb itself, with
+bpf_redirect(), once the ifb's index is in the new ingress_ifb map,
+which qosify writes once the ifb exists; without it, the packets go on
+unshaped. An ifb takes link-layer frames: a packet of a device without
+a link-layer header, such as pppoe-wan, first gets an Ethernet header,
+which the ifb strips again as it returns the packet. At ingress,
+bpf_skb_change_head() has no MTU limit. The ifb's cake of such a device
+gets overhead 0, so that it counts from the network header, as before,
+not that header too; the options may set another overhead.
+
+A kernel without tcx refuses the link (EINVAL or EOPNOTSUPP), and
+qosify then attaches as before, as a cls_bpf filter under clsact, which
+it adds only for that. The config option tcx, true by default, set to
+false makes it do so on any kernel.
