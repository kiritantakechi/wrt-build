++	prepare_qdisc_cmd(buf, sizeof(buf), iface->ifname, true, "clsact");
++	qosify_run_cmd(buf, true);
++
++	return cmd_add_bpf_filter(iface->ifname, QOSIFY_PRIO_BASE, egress, eth);
++}
