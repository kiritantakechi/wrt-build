#!/bin/sh
# wrt-snap: read-only snapshots of the data disk's containers and shares
# (r4s-services D5).
# Usage: wrt-snap now | prune | list [subvolume]
# now takes one of each, as .snapshots/<subvolume>/<UTC time>; prune keeps, of
# each subvolume, the snapshots of the seven most recent days (UTC) on which it
# got one, whatever time of day each was taken and however long ago: a clock set
# ahead or weeks without power cost one day's at most (device-integrity D6). cron
# runs both once a day. A file comes back by copying it out of a snapshot
# (docs/services.md).
set -eu
# shellcheck source=../../lib/functions/wrt-data.sh
. /lib/functions/wrt-data.sh

SNAPSHOTTED="containers shares"
KEEP_DAYS=7
SNAPSHOTS="${WRT_DATA}/.snapshots"

die() {
	echo "wrt-snap: $*" >&2
	exit 1
}

now() {
	# ISO 8601 basic format: the names sort by time. A name taken already (a
	# snapshot of this second) would have btrfs snapshot into that snapshot:
	# wait for the next second instead.
	while :; do
		at=$(date -u +%Y%m%dT%H%M%SZ)
		free=1
		for subvolume in ${SNAPSHOTTED}; do
			[ ! -e "${SNAPSHOTS}/${subvolume}/${at}" ] || free=0
		done
		[ "${free}" = 0 ] || break
		sleep 1
	done
	for subvolume in ${SNAPSHOTTED}; do
		mkdir -p "${SNAPSHOTS}/${subvolume}"
		btrfs -q subvolume snapshot -r "${WRT_DATA}/${subvolume}" "${SNAPSHOTS}/${subvolume}/${at}"
		echo "${SNAPSHOTS}/${subvolume}/${at}"
	done
}

prune() {
	for of in "${SNAPSHOTS}"/*; do
		[ -d "${of}" ] || continue
		# The names begin with their day: the newest days first, space-separated.
		kept=$(for snapshot in "${of}"/*; do echo "${snapshot##*/}"; done |
			cut -c1-8 | sort -ru | head -n "${KEEP_DAYS}" | tr '\n' ' ')
		for snapshot in "${of}"/*; do
			[ -d "${snapshot}" ] || continue
			day=${snapshot##*/}
			case " ${kept}" in
				*" ${day%%T*} "*) ;;
				*) btrfs -q subvolume delete "${snapshot}" ;;
			esac
		done
	done
}

# list [subvolume]: the snapshots (of one subvolume), oldest first.
list() {
	for snapshot in "${SNAPSHOTS}"/*/*; do
		[ -d "${snapshot}" ] || continue
		of=${snapshot%/*}
		[ -z "$1" ] || [ "${of##*/}" = "$1" ] || continue
		echo "${snapshot}"
	done
}

grep -q "${WRT_DATA_MOUNT}" /proc/mounts || die "the data disk is not mounted"
case "${1:-}" in
	now | prune) "$1" ;;
	list) list "${2:-}" ;;
	*) die "usage: wrt-snap now | prune | list [subvolume]" ;;
esac
