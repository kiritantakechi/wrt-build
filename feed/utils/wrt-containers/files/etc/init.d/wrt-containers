#!/bin/sh /etc/rc.common
# wrt-containers: the Pods on the data disk (r4s-services D2, D4). They start once
# /mnt/data is mounted, and again whenever it is. podman runs only while it is
# mounted: run anywhere else, it would make its storage on the SD card. podman's
# own API service stays off.
# shellcheck source=../../../../wrt-data/files/lib/functions/wrt-data.sh

# shellcheck disable=SC2034 # read by /etc/rc.common
START=99
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	. /lib/functions/wrt-data.sh
	wrt_data_mounted || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/wrt-containers apply
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	. /lib/functions/wrt-data.sh
	wrt_data_mounted || return 0
	podman pod stop --all >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_restart_mount_trigger /mnt/data/containers
}
