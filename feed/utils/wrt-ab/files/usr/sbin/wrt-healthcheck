#!/usr/bin/ucode
// wrt-healthcheck: decide whether this boot of the slot is healthy (r4s-ab-rollback D5).
// Usage: wrt-healthcheck   (once per boot, from /etc/init.d/wrt-healthcheck)
// Checks until all pass or the total time is up, then records the result. During
// a trial boot a pass confirms the slot, and a failure reboots so that U-Boot
// counts the boot; on a confirmed slot a failure is only recorded. WAN state is
// never a criterion: an ISP outage says nothing about the system. A U-Boot
// environment that cannot be read fails the check named environment and never
// reboots, the trial state being unknown; a pass whose confirmation cannot be
// written fails the check named confirm, and the slot stays on trial
// (device-integrity D1).
'use strict';

import { access, lsdir, readfile, writefile } from 'fs';
import { cursor } from 'uci';
import * as ubus from 'ubus';
import { setenv, slot, variables } from 'wrt.ab';

const RESULT = '/var/run/wrt-healthcheck.json';
const CHECKS = '/etc/healthcheck.d';

// setting(name, fallback): a time limit from /etc/config/wrt-ab, in seconds.
function setting(name, fallback) {
	return +(cursor().get('wrt-ab', 'healthcheck', name) ?? fallback);
}

// seconds(): seconds on the monotonic clock, which setting the time of day does
// not move, as NTP does once the router is online (trial-boot-resilience D4).
function seconds() {
	return clock(true)[0];
}

function log(level, message) {
	system(['logger', '-t', 'wrt-healthcheck', '-p', `daemon.${level}`, message]);
}

// quoted(word): word as one argument of a shell command line.
function quoted(word) {
	return `'${replace(word, "'", "'\\''")}'`;
}

// listening(port, address): a TCP socket listens on the port, on that IPv4
// address or on every address (IPv4 or IPv6).
function listening(port, address) {
	let octets = map(split(address, '.'), (octet) => +octet);
	let wanted = sprintf('%02X%02X%02X%02X', octets[3], octets[2], octets[1], octets[0]);
	let local_port = sprintf('%04X', port);

	for (let table in ['/proc/net/tcp', '/proc/net/tcp6']) {
		for (let line in split(readfile(table) ?? '', '\n')) {
			let fields = split(trim(line), /\s+/);
			let local = split(fields[1] ?? '', ':');

			if (fields[3] == '0A' && length(local) == 2 && local[1] == local_port &&
				(local[0] == wanted || match(local[0], /^0+$/)))
				return true;
		}
	}

	return false;
}

// run_checks(timeout, environment): the names of the checks that failed: the
// built-in ones (the U-Boot environment could be read, ubus answers, the LAN is
// up with an address, SSH and the web server listen on it), then every
// executable in /etc/healthcheck.d, which gets the per-check time limit and
// passes by exiting 0.
function run_checks(timeout, environment) {
	let failed = environment ? [] : ['environment'];
	let connection = ubus.connect(null, 5);
	let lan = connection?.call('network.interface.lan', 'status');
	let address = lan?.['ipv4-address']?.[0]?.address;

	if (connection?.call('system', 'board') == null)
		push(failed, 'ready');

	if (!lan?.up || !address)
		push(failed, 'lan');

	if (!listening(22, address ?? '0.0.0.0'))
		push(failed, 'ssh');

	if (!listening(80, address ?? '0.0.0.0'))
		push(failed, 'web');

	connection?.disconnect();

	for (let name in sort(lsdir(CHECKS) ?? [])) {
		let check = `${CHECKS}/${name}`;

		if (access(check, 'x') &&
			system(`timeout ${timeout} ${quoted(check)} >/dev/null 2>&1`) != 0)
			push(failed, name);
	}

	return failed;
}

function record(running, result, failed) {
	writefile(RESULT, sprintf('%J\n', { time: time(), slot: running, result: result, failed: failed }));
}

let total = setting('total', 300);
let interval = setting('interval', 10);
let timeout = setting('timeout', 30);
let running = slot();
// Read once: whether this boot is a trial does not change while it runs. One
// that cannot be read leaves the trial state unknown, so it never reboots.
let environment = variables();
let trial = environment?.upgrade_available == '1';
let start = seconds();
let failed;

while (true) {
	failed = run_checks(timeout, environment);

	if (!length(failed) || seconds() - start >= total)
		break;

	sleep(interval * 1000);
}

if (length(failed)) {
	record(running, 'fail', failed);

	if (trial) {
		log('err', `slot ${running} failed its trial boot: ${join(' ', failed)}; rebooting`);
		system(['reboot']);
	}
	else
		log('err', `slot ${running} is unhealthy: ${join(' ', failed)}`);
}
else if (!trial)
	record(running, 'pass', failed);
else if (setenv({ boot_slot: running, upgrade_available: 0, bootcount: 0 })) {
	record(running, 'pass', failed);
	log('notice', `slot ${running} passed its trial boot and is confirmed`);
}
else {
	// Healthy, but still on trial: U-Boot counts the next boots.
	record(running, 'fail', ['confirm']);
	log('err', `slot ${running} passed its trial boot, but writing the U-Boot environment failed: it stays on trial`);
}
