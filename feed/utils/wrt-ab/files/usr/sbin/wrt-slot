#!/usr/bin/ucode
// wrt-slot: show the A/B state, or switch to the other slot (r4s-ab-rollback D4).
// Usage: wrt-slot status | wrt-slot switch
// switch makes the other slot the trial slot and reboots into it; the health
// check confirms it, or U-Boot rolls back after three unconfirmed boots.
'use strict';

import { readfile } from 'fs';
import { other, setenv, slot, variables } from 'wrt.ab';

const RESULT = '/var/run/wrt-healthcheck.json';

// running(): the running slot; leaves on a system not booted from a slot.
function running() {
	let current = slot();

	if (!current) {
		warn('wrt-slot: this system was not booted from a slot\n');
		exit(1);
	}

	return current;
}

// health(): the most recent health check, as one line.
function health() {
	let text = readfile(RESULT);

	if (!length(text))
		return 'pending';

	let checked = json(text);
	let at = localtime(checked.time);
	let failed = join(' ', checked.failed);

	return sprintf('%s at %04d-%02d-%02d %02d:%02d:%02d%s', checked.result,
		at.year, at.mon, at.mday, at.hour, at.min, at.sec,
		length(failed) ? ` (failed: ${failed})` : '');
}

function status() {
	let environment = variables();
	let state = 'confirmed';

	if (!environment)
		state = 'unknown: the U-Boot environment cannot be read';
	else if (environment.upgrade_available == '1')
		state = sprintf('trial, boot %s of %s',
			environment.bootcount ?? '0', environment.bootlimit ?? '3');

	printf('slot: %s\nstate: %s\nhealth: %s\n', running(), state, health());
}

function switch_slot() {
	let target = other(running());

	if (!setenv({ boot_slot: target, upgrade_available: 1, bootcount: 0 })) {
		warn('wrt-slot: writing the U-Boot environment failed\n');
		exit(1);
	}

	printf('slot %s is the trial slot now; rebooting\n', target);
	system(['reboot']);
}

switch (ARGV[0]) {
case 'status':
	status();
	break;

case 'switch':
	switch_slot();
	break;

default:
	warn('usage: wrt-slot status | wrt-slot switch\n');
	exit(2);
}
