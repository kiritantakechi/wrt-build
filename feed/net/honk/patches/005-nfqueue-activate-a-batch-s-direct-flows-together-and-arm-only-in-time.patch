+    /// The hold that arming must leave for the activation of a batch's
+    /// `place`-th armed flow, which waits for the activation of the flows
+    /// armed before it (activation is FIFO).
+    pub(super) fn activation_reserve(&self, place: usize) -> Duration {
+        let flows = u32::try_from(place).unwrap_or(u32::MAX);
+        ACTIVATION_MARGIN
+            .saturating_add(self.activation_cost.lock().saturating_mul(flows))
+            .min(ACTIVATION_RESERVE_MAX)
+    }
+
+    pub(super) fn record_activations(&self, elapsed: Duration, flows: usize) {
+        let Some(flows) = u32::try_from(flows).ok().filter(|&flows| flows > 0) else {
+            return;
+        };
+        let mut cost = self.activation_cost.lock();
+        *cost = (*cost * 3 + elapsed / flows) / 4;
+    }
 }
 
