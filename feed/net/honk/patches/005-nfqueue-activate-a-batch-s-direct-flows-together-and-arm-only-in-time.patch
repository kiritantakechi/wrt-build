+/// The fixture's flow and `count` more, each with `remaining` of its hold
+/// left and one held original; return the more flows' leases and identities.
+fn staged(
+    count: u16,
+    remaining: Duration,
+) -> (DecisionFixture, Vec<(UdpInitLease, PendingUdpIdentity)>) {
+    let mut mock = MockEbpfBackend::new();
+    let keys: Vec<_> = (1..=count)
+        .map(|port| {
+            FlowKey::new(
+                std::net::SocketAddr::from(([192, 0, 2, 10], 40000 + port)),
+                "198.51.100.20:443".parse().unwrap(),
+            )
+        })
+        .collect();
+    for (key, token) in keys.iter().zip(100..) {
+        mock.seed_staged_udp_flow(
+            &key.tuples(),
+            retained(
+                token,
+                UdpDecisionState::Pending,
+                ROUTING_META_FLAG_PUBLISHED,
+            ),
+        );
+    }
+    let fixture = pending_fixture_with(41, mock);
+    deadline(&fixture, remaining);
+    let flows = keys
+        .into_iter()
+        .zip(100..)
+        .map(|(key, token)| {
+            let lease = match fixture.pending.endpoints.reserve_owned_or_enqueue(
+                key.client,
+                key.destination,
+                bytes::Bytes::from_static(b"more"),
+                token,
+                None,
+                test_flow_slot(),
+                &fixture.stats,
+            ) {
+                EndpointReservation::Initializing(lease) => lease,
+                _ => panic!("each flow must initialize"),
+            };
+            let identity = PendingUdpVerdicts::identity_for_lease(&lease);
+            fixture.pending.cells.insert(
+                key,
+                Arc::new(FlowCell::pending(
+                    identity,
+                    Instant::now() - HARD_HOLD_TIMEOUT + remaining,
+                    HeldVerdict::test(u64::from(token), Instant::now(), Arc::clone(&fixture.sink)),
+                    Arc::clone(&fixture.pending.flow_slots)
+                        .try_acquire_owned()
+                        .unwrap(),
+                )),
+            );
+            fixture.stats.increment_udp_nfqueue_active_flows();
+            (lease, identity)
+        })
+        .collect();
+    (fixture, flows)
+}
+
+/// Direct flows decided together are activated together: one backend
+/// acquisition for the batch, not one for each flow behind whatever holds the
+/// backend meanwhile (the janitor's scans hold it for reading).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn direct_flows_decided_together_are_activated_together() {
+    let (fixture, flows) = staged(19, Duration::from_millis(1200));
+    let scanning = Arc::new(std::sync::atomic::AtomicBool::new(true));
+    let scanner = tokio::task::spawn_blocking({
+        let backend = Arc::clone(&fixture.backend);
+        let scanning = Arc::clone(&scanning);
+        move || {
+            while scanning.load(Ordering::Acquire) {
+                let scan = backend.blocking_read();
+                std::thread::sleep(Duration::from_millis(150));
+                drop(scan);
+            }
+        }
+    });
+    let decisions = std::iter::once(fixture.pending.activate_direct(
+        fixture.identity,
+        fixture.lease,
+        0x1200,
+    ))
+    .chain(
+        flows
+            .into_iter()
+            .map(|(lease, identity)| fixture.pending.activate_direct(identity, lease, 0x1200)),
+    );
+    let results = futures::future::join_all(decisions).await;
+    scanning.store(false, Ordering::Release);
+    scanner.await.unwrap();
+    for result in results {
+        result.unwrap();
+    }
+    let mut fatal = fixture.fatal;
+    assert!(fatal.try_recv().is_err(), "no flow missed its activation");
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// A flow armed without time for its activation would be fatal when the
+/// activation misses its hold: such a flow expires unarmed instead, and its
+/// originals are dropped.
+#[tokio::test]
+async fn a_flow_without_time_for_its_activation_expires_unarmed() {
+    let mock = MockEbpfBackend::new();
+    let trace = Arc::clone(&mock.commit_trace);
+    let mut fixture = pending_fixture_with(45, mock);
+    deadline(&fixture, ACTIVATION_MARGIN / 2);
+    let result = fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200)
+        .await;
+    assert!(result.is_err(), "{result:?}");
+    assert!(trace.lock().is_empty(), "nothing was armed");
+    assert!(fixture.fatal.try_recv().is_err());
+    assert_eq!(*fixture.sink.lock(), vec![TestVerdict::Drop { id: 1 }]);
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+#[test]
+fn the_activation_reserve_follows_the_activations() {
+    let pump = commit::CommitPump::new();
+    assert_eq!(pump.activation_reserve(10), ACTIVATION_MARGIN);
+    pump.record_activations(Duration::from_millis(40), 4);
+    assert_eq!(
+        pump.activation_reserve(10),
+        ACTIVATION_MARGIN + Duration::from_micros(2500) * 10
+    );
+    pump.record_activations(Duration::from_secs(60), 1);
+    assert_eq!(pump.activation_reserve(1), ACTIVATION_RESERVE_MAX);
+}
+
+/// However long activations have taken, a flow fresh from the queue is still
+/// armed and activated: arming never withholds the whole hold, so it cannot
+/// lock every direct flow out.
+#[tokio::test]
+async fn a_fresh_flow_is_armed_however_long_activations_took() {
+    let mut fixture = pending_fixture(46);
+    fixture
+        .pending
+        .commits
+        .record_activations(Duration::from_secs(60), 1);
+    fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200)
+        .await
+        .unwrap();
+    assert!(fixture.fatal.try_recv().is_err());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
+
+/// Activation is FIFO, so a batch's first armed flow reserves its own
+/// activation only, and a later one its own and those before it.
+#[tokio::test]
+async fn each_flow_reserves_the_activations_before_it() {
+    let (mut fixture, second, second_id) = pair(MockEbpfBackend::new());
+    // One second of activation work a flow.
+    fixture
+        .pending
+        .commits
+        .record_activations(Duration::from_secs(4), 1);
+    let remaining = Duration::from_millis(1400);
+    deadline(&fixture, remaining);
+    {
+        let cell = fixture.pending.matching_cell(second_id).unwrap();
+        let mut state = cell.state.lock();
+        let CellState::Pending { started_at, .. } = &mut *state else {
+            panic!("pending")
+        };
+        *started_at = Instant::now() - HARD_HOLD_TIMEOUT + remaining;
+    }
+    let first = fixture
+        .pending
+        .activate_direct(fixture.identity, fixture.lease, 0x1200);
+    let second = fixture.pending.activate_direct(second_id, second, 0x1200);
+    let (first, second) = tokio::join!(biased; first, second);
+    first.unwrap();
+    assert!(second.is_err(), "{second:?}");
+    assert!(fixture.fatal.try_recv().is_err());
+    fixture.pending.shutdown_commit_pump().await.unwrap();
+}
