+/// The kernel answers a verdict on the queue's socket, where the listener
+/// reads, only when it fails: verdicts ask for no acknowledgement. ENOENT
+/// says that the packet is no longer queued: the kernel dropped it before its
+/// verdict came, as it drops the queued packets of a device that goes down,
+/// and nothing is left to decide. Any other answer is fatal.
+fn verdict_answer(message: &netlink::Message) -> Result<(), FatalError> {
+    // struct nlmsgerr: the error, then the header of the request it answers.
+    let Some(answer) = message.body.get(..4 + netlink::NLMSG_HDRLEN) else {
+        return Err(FatalError::MalformedMessage {
+            error: "truncated NLMSG_ERROR".into(),
+        });
+    };
+    let error = i32::from_ne_bytes(answer[..4].try_into().expect("four bytes"));
+    let request_type = u16::from_ne_bytes(answer[8..10].try_into().expect("two bytes"));
+    if request_type != (netlink::NFNL_SUBSYS_QUEUE << 8) | NFQNL_MSG_VERDICT || error == 0 {
+        return Err(FatalError::UnexpectedMessage {
+            message_type: message.message_type,
+        });
+    }
+    match -error {
+        libc::ENOENT => Ok(()),
+        errno => Err(FatalError::VerdictRefused {
+            error: io::Error::from_raw_os_error(errno).to_string(),
+        }),
+    }
+}
