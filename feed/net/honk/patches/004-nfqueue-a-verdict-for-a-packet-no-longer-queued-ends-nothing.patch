+    /// The kernel's answer to a failed request: `struct nlmsgerr`, the error
+    /// and the request's header.
+    fn answer(error: i32, request_type: u16) -> Vec<u8> {
+        fn header(message: &mut Vec<u8>, length: usize, kind: u16, flags: u16) {
+            message.extend_from_slice(&(length as u32).to_ne_bytes());
+            message.extend_from_slice(&kind.to_ne_bytes());
+            message.extend_from_slice(&flags.to_ne_bytes());
+            message.extend_from_slice(&7u32.to_ne_bytes());
+            message.extend_from_slice(&0u32.to_ne_bytes());
+        }
+        let mut message = Vec::new();
+        header(
+            &mut message,
+            2 * netlink::NLMSG_HDRLEN + 4,
+            netlink::NLMSG_ERROR,
+            0,
+        );
+        message.extend_from_slice(&error.to_ne_bytes());
+        header(
+            &mut message,
+            netlink::NLMSG_HDRLEN,
+            request_type,
+            netlink::NLM_F_REQUEST,
+        );
+        message
+    }
+
+    #[test]
+    fn a_verdict_for_a_packet_no_longer_queued_ends_nothing() {
+        let (socket, _peer, mut fatal) = QueueSocket::for_test();
+        let tracker = GuardTracker::new();
+        let (sender, events) = std::sync::mpsc::channel();
+        let callback: PacketCallback = Arc::new(move |event, mut guard| {
+            guard.accept(0x400).unwrap();
+            sender.send(event).unwrap();
+        });
+        let verdict = netlink::NFNL_SUBSYS_QUEUE << 8 | NFQNL_MSG_VERDICT;
+        // The kernel dropped a packet before its verdict came; the next follows.
+        let mut datagram = answer(-libc::ENOENT, verdict);
+        datagram.extend_from_slice(&queued_udp_message(12, 12, 0));
+        dispatch_datagram(
+            Bytes::from(datagram),
+            Instant::now(),
+            &socket,
+            &callback,
+            &tracker,
+        )
+        .expect("a verdict for a packet no longer queued ends nothing");
+        assert!(matches!(events.try_recv(), Ok(PacketEvent::Datagram(_))));
+        assert!(fatal.try_recv().is_err());
+
+        let config = netlink::NFNL_SUBSYS_QUEUE << 8 | NFQA_MSG_CONFIG;
+        for (error, request_type, refused) in [
+            (-libc::EPERM, verdict, true),
+            (0, verdict, false),
+            (-libc::ENOENT, config, false),
+        ] {
+            let error = dispatch_datagram(
+                Bytes::from(answer(error, request_type)),
+                Instant::now(),
+                &socket,
+                &callback,
+                &tracker,
+            )
+            .expect_err("any other answer is fatal");
+            match error {
+                FatalError::VerdictRefused { .. } => assert!(refused, "{error}"),
+                FatalError::UnexpectedMessage { message_type } => {
+                    assert!(!refused && message_type == netlink::NLMSG_ERROR, "{error}");
+                }
+                other => panic!("unexpected fatal error: {other}"),
+            }
+        }
+    }
+
