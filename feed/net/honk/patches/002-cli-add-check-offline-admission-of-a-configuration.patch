--- /dev/null
+++ b/crates/honk-core/src/check.rs
@@ -0,0 +1,169 @@
+//! `honk-core check`: admit a configuration offline, as a start would.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use honk_config::Config;
+use honk_config::diagnostic::{DetailedDiagnostic, Severity};
+use honk_config::error::DetailedConfigError;
+use honk_config::parser::SourceLimits;
+
+use crate::native_api::offline;
+
+/// Admits the configuration entry at `path` as a start would: parses it with
+/// its includes, validates it, and compiles its routing and DNS against the
+/// assets it finds, its data directory's first. As a start does, it takes a
+/// required geo asset that is missing as a warning: that asset's rules match
+/// nothing until it is installed or fetched. Nothing is bound, attached,
+/// created or written.
+///
+/// Returns whether honk would start with the configuration. Every finding,
+/// the one that refuses it included, is left in `diagnostics`.
+pub(crate) fn check(path: &Path, diagnostics: &mut Vec<DetailedDiagnostic>) -> bool {
+    admit(path, diagnostics).is_ok()
+        && !diagnostics
+            .iter()
+            .any(|diagnostic| diagnostic.severity == Severity::Error)
+}
+
+fn admit(
+    path: &Path,
+    diagnostics: &mut Vec<DetailedDiagnostic>,
+) -> Result<(), DetailedConfigError> {
+    let loaded = Config::from_dae_file_with_sources(
+        path,
+        &HashMap::new(),
+        SourceLimits::default(),
+        diagnostics,
+    )?;
+    let data_dir = PathBuf::from(&loaded.config.global.data_dir);
+    offline::validate_for_start(
+        loaded,
+        path.parent(),
+        &data_dir,
+        SourceLimits::default(),
+        diagnostics,
+    )?;
+    Ok(())
+}
+
+/// One line for a finding: the file and position it names, its severity and
+/// code, the setting and the message. Values stay out, as they may be secret.
+pub(crate) fn render(diagnostic: &DetailedDiagnostic) -> String {
+    let file = diagnostic
+        .source
+        .sources()
+        .metadata()
+        .get(diagnostic.source.index())
+        .and_then(|source| source.path.clone());
+    let mut location =
+        file.map_or_else(|| "<config>".to_owned(), |file| file.display().to_string());
+    if let Some(line) = diagnostic.line {
+        location.push_str(&format!(":{line}"));
+        if let Some(column) = diagnostic.byte_column {
+            location.push_str(&format!(":{column}"));
+        }
+    }
+    let severity = match diagnostic.severity {
+        Severity::Info => "info",
+        Severity::Warning => "warning",
+        Severity::Error => "error",
+    };
+    format!(
+        "{location}: {severity}[{}]: {}: {}",
+        diagnostic.code, diagnostic.setting, diagnostic.message
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    fn entry(directory: &Path, text: &str) -> PathBuf {
+        let path = directory.join("config.dae");
+        fs::write(
+            &path,
+            format!(
+                "global {{\n data_dir: '{}'\n nfqueue_enable: false\n dial_mode: ip\n}}\n{text}",
+                directory.join("state").display(),
+            ),
+        )
+        .unwrap();
+        path
+    }
+
+    #[test]
+    fn admits_a_configuration_a_start_would_and_creates_nothing() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = entry(
+            temp.path(),
+            "node {\n exit: 'socks5://192.0.2.1:1080'\n}\ngroup {\n proxy {\n  policy: select\n }\n}\nrouting {\n dip(geoip: private) -> direct\n fallback: proxy\n}\n",
+        );
+        let mut diagnostics = Vec::new();
+        assert!(check(&path, &mut diagnostics), "{diagnostics:?}");
+        assert!(!temp.path().join("state").exists());
+    }
+
+    #[test]
+    fn admits_a_configuration_whose_geodata_is_not_there_yet_with_a_warning() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = entry(
+            temp.path(),
+            "routing {\n domain(geosite: cn) -> direct\n fallback: direct\n}\n",
+        );
+        let mut diagnostics = Vec::new();
+        assert!(check(&path, &mut diagnostics), "{diagnostics:?}");
+        assert!(
+            diagnostics
+                .iter()
+                .any(|diagnostic| diagnostic.code == "geo-asset-missing"
+                    && diagnostic.severity == Severity::Warning),
+            "{diagnostics:?}"
+        );
+    }
+
+    #[test]
+    fn refuses_a_routing_target_no_group_declares() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = entry(temp.path(), "routing {\n fallback: missing\n}\n");
+        let mut diagnostics = Vec::new();
+        assert!(!check(&path, &mut diagnostics));
+        let refusal = diagnostics.last().unwrap();
+        assert_eq!(refusal.code, "unknown-routing-target");
+        let line = render(refusal);
+        assert!(line.starts_with(&path.display().to_string()), "{line}");
+        assert!(
+            line.contains("error[unknown-routing-target]: routing.fallback:"),
+            "{line}"
+        );
+    }
+
+    #[test]
+    fn refuses_a_syntax_error() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = entry(temp.path(), "routing {{\n fallback: direct\n}\n");
+        let mut diagnostics = Vec::new();
+        assert!(!check(&path, &mut diagnostics));
+        assert!(
+            diagnostics
+                .iter()
+                .any(|diagnostic| diagnostic.severity == Severity::Error)
+        );
+    }
+
+    #[test]
+    fn refuses_an_include_outside_the_entry_s_directory() {
+        let temp = tempfile::tempdir().unwrap();
+        let entry_dir = temp.path().join("entry");
+        fs::create_dir(&entry_dir).unwrap();
+        fs::write(
+            temp.path().join("outside.dae"),
+            "routing {\n fallback: direct\n}\n",
+        )
+        .unwrap();
+        let path = entry(&entry_dir, "include {\n ../outside.dae\n}\n");
+        let mut diagnostics = Vec::new();
+        assert!(!check(&path, &mut diagnostics));
+    }
+}
