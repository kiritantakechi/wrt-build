     finish_attempt(result, diagnostics)
 }
 
+/// Admits `loaded` as a start or a reload does, with the configuration as its
+/// own active one: as [`validate_for_coordinator`] admits a candidate, except
+/// that a required geo asset that is missing leaves its matchers empty, with a
+/// warning, where a candidate is refused.
+pub(crate) fn validate_for_start(
+    loaded: LoadedConfig,
+    dependency_root: Option<&Path>,
+    data_dir: &Path,
+    limits: SourceLimits,
+    diagnostics: &mut Vec<DetailedDiagnostic>,
+) -> Result<ValidatedConfig, DetailedConfigError> {
+    let active = loaded.config.clone();
+    let requirements = GeoRequirements::for_traffic(&active.routing.rules)
+        .union(&DnsRouter::geo_requirements(&active.dns));
+    let geo = GeoSourceSet::load_from(&requirements, data_dir);
+    if let Some(entry) = loaded.sources.first() {
+        for asset in geo.missing() {
+            diagnostics.push(DetailedDiagnostic::warning(
+                "geo-asset-missing",
+                entry.source.clone(),
+                SettingPath::new("global").field("data_dir"),
+                SafeValue::Empty,
+                match asset {
+                    "geosite.dat" => {
+                        "geosite.dat is missing; the rules that use it match nothing until it is installed or fetched"
+                    }
+                    _ => {
+                        "geoip.dat is missing; the rules that use it match nothing until it is installed or fetched"
+                    }
+                },
+            ));
+        }
+    }
+    let result = capture_inner(
+        loaded,
+        dependency_root,
+        &active,
+        data_dir,
+        limits,
+        diagnostics,
+        Some(&geo),
+        &[],
+        &[],
+    )
+    .and_then(CapturedConfig::compile);
+    finish_attempt(result, diagnostics)
+}
+
