From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kiritantakechi <kiritantakechi@gmail.com>
Date: Fri, 13 Nov 2026 12:00:00 +0800
Subject: [PATCH] daens: keep the namespace registry as other tools share it

honk binds its daens namespace into /run/netns for ip netns, the
registry of named network namespaces that iproute2 keeps and podman,
CNI and others share. Where the registry was no mountpoint, honk
mounted a tmpfs over it, and unmounted that tmpfs on cleanup: every
namespace another tool registered while honk ran went with it, so a
stop or restart of honk takes the network namespaces of running
containers out of the registry, and podman then fails to start or tear
down their networks ("netavark: invalid namespace path: ... No such
file or directory").

Whether the registry was a mountpoint was read from /proc/mounts by its
unresolved path. /proc/mounts lists resolved paths, so where /run or
/var/run is a symlink (OpenWrt: both lead to /tmp/run) it never
matched: every start mounted another tmpfs over the registry, hiding
the namespaces registered before it, and the stale daens mount of a run
that did not clean up was never detached.

Make the registry a mountpoint as iproute2 and podman make it: make it
shared, and where that fails with EINVAL because it is no mountpoint,
bind it onto itself first, recursively, so that every namespace already
registered there stays in view. Nothing undoes it. Detach a stale daens
mount by its path, which the kernel resolves, whether or not one is
there; is_mountpoint() goes.

A root-only test in a private mount and network namespace registers a
namespace before the setup, while the registry is no mountpoint, and
one during it, and checks that both still name a namespace after the
cleanup.

Signed-off-by: kiritantakechi <kiritantakechi@gmail.com>
Upstream-Status: Pending
---
 crates/honk-core/src/daens.rs | 157 ++++++++++++++++++++++++----------
 1 file changed, 110 insertions(+), 47 deletions(-)

diff --git a/crates/honk-core/src/daens.rs b/crates/honk-core/src/daens.rs
index dee58e5..5e3d2f5 100644
--- a/crates/honk-core/src/daens.rs
+++ b/crates/honk-core/src/daens.rs
@@ -92,10 +92,10 @@ pub(crate) fn create_dae0_link() -> anyhow::Result<(Dae0Guard, Dae0Setup)> {
 
     // Stale-state cleanup (previous run): drop the compat bind-mount (the
     // FD-held namespace dies with its owner process) and any leftover dae0.
-    // The singleton lock guarantees no live sibling owns these names.
-    if is_mountpoint("/run/netns/daens") {
-        let _ = nix::mount::umount2(DAENS_NS_PATH, nix::mount::MntFlags::MNT_DETACH);
-    }
+    // The singleton lock guarantees no live sibling owns these names. The
+    // kernel resolves the path, symlinks included; a path that is no
+    // mountpoint fails the detach (EINVAL) and has nothing to clean.
+    let _ = nix::mount::umount2(DAENS_NS_PATH, nix::mount::MntFlags::MNT_DETACH);
     if let Ok(idx) = netlink::ifindex_of("dae0")
         && let Ok(mut nl) = netlink::NlSock::new()
     {
@@ -326,6 +326,11 @@ pub(crate) fn setup_daens_namespace(tproxy_mark: u32, tproxy_port: u16) -> anyho
 #[cfg(target_os = "linux")]
 pub(crate) const DAENS_NS_PATH: &str = "/var/run/netns/daens";
 
+/// The registry of named network namespaces, as `ip netns` keeps it, which
+/// podman and other tools share.
+#[cfg(feature = "ebpf")]
+const NETNS_RUN_DIR: &str = "/var/run/netns";
+
 /// Runtime truth for "daens is set up", set by [`setup_daens_namespace`]
 /// on success. Socket creation must key on this, never on
 /// `DAENS_NS_PATH` existing — a leftover or failed compat mount says
@@ -341,8 +346,8 @@ pub(crate) static DAENS_READY: std::sync::atomic::AtomicBool =
 #[cfg(feature = "ebpf")]
 static COMPAT_MOUNTED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
 /// Whether THIS instance created the regular file used as the compat
-/// bind-mount target. If `/run/netns` belongs to iproute2, unmounting the
-/// child does not remove that file, so cleanup must remove its own target.
+/// bind-mount target. The registry outlives this instance
+/// ([`share_netns_registry`]), so cleanup removes its own target.
 #[cfg(feature = "ebpf")]
 static COMPAT_FILE_CREATED: std::sync::atomic::AtomicBool =
     std::sync::atomic::AtomicBool::new(false);
@@ -353,13 +358,6 @@ static COMPAT_FILE_CREATED: std::sync::atomic::AtomicBool =
 #[cfg(feature = "ebpf")]
 static DAENS_FD: std::sync::OnceLock<std::os::unix::io::OwnedFd> = std::sync::OnceLock::new();
 
-/// Whether THIS instance mounted the tmpfs at /run/netns (the compat
-/// bind-mount's parent). Tracked separately from [`COMPAT_MOUNTED`]:
-/// cleanup unmounts the parent only when it is ours.
-#[cfg(feature = "ebpf")]
-static PARENT_TMPFS_MOUNTED: std::sync::atomic::AtomicBool =
-    std::sync::atomic::AtomicBool::new(false);
-
 /// Create the daens network namespace without iproute2: a throwaway thread
 /// `unshare(CLONE_NEWNET)`s, hands its `/proc/thread-self/ns/net` FD back
 /// (the FD pins the namespace after the thread exits), and the FD is stored
@@ -384,31 +382,10 @@ fn create_daens_namespace() -> anyhow::Result<&'static std::os::unix::io::OwnedF
         let task_ns = "/proc/thread-self/ns/net";
         // Best-effort compat mount: /var/run/netns/daens (iproute2 shape).
         // The target must be a FILE — namespace handles are files, and a
-        // file bind-mount onto a directory fails with ENOTDIR. The parent
-        // is made a mountpoint (tmpfs) only if it isn't one already —
-        // crucially NOT via a self-MS_BIND, which would stack-duplicate
-        // every nsfs mount beneath it (lab ns pins included) on every
-        // engine restart.
-        let _ = std::fs::create_dir_all("/var/run/netns");
-        // /proc/mounts lists the real path (/var/run is a symlink to
-        // /run) — check the canonical path or every engine start
-        // mounts a fresh tmpfs over the registry, hiding iproute2's
-        // namespace files (the lab netns "disappears"). The tmpfs must
-        // be mounted BEFORE the target file is created, or the mount
-        // hides it and the bind below fails on a first clean deploy.
-        if !is_mountpoint("/run/netns") {
-            match nix::mount::mount(
-                Some("tmpfs"),
-                "/var/run/netns",
-                Some("tmpfs"),
-                nix::mount::MsFlags::empty(),
-                None::<&str>,
-            ) {
-                Ok(()) => {
-                    PARENT_TMPFS_MOUNTED.store(true, std::sync::atomic::Ordering::Relaxed);
-                }
-                Err(error) => warn!("tmpfs mount on /run/netns failed: {error}"),
-            }
+        // file bind-mount onto a directory fails with ENOTDIR.
+        let _ = std::fs::create_dir_all(NETNS_RUN_DIR);
+        if let Err(error) = share_netns_registry(NETNS_RUN_DIR) {
+            warn!("sharing {NETNS_RUN_DIR} failed: {error}");
         }
         let compat_target_ready = match std::fs::OpenOptions::new()
             .write(true)
@@ -592,10 +569,8 @@ fn cleanup_dae0_interface(recorded_ifindex: Option<u32>) {
     {
         warn!("remove compat daens target failed: {error}");
     }
-    // Same ownership rule for the parent tmpfs (child must go first).
-    if PARENT_TMPFS_MOUNTED.swap(false, std::sync::atomic::Ordering::Relaxed) {
-        let _ = nix::mount::umount2("/run/netns", nix::mount::MntFlags::MNT_DETACH);
-    }
+    // The registry itself stays: other tools' namespaces in it outlive
+    // this instance (share_netns_registry).
     DAENS_READY.store(false, std::sync::atomic::Ordering::Release);
     // The FD-owned namespace dies with the process (dae0peer goes with it).
 
@@ -653,12 +628,38 @@ pub(crate) const DAENS_HOST_IPV6: &str = "fd00:686f:6e6b::1";
 #[cfg(any(feature = "ebpf", test))]
 pub(crate) const DAENS_PEER_IPV6: &str = "fd00:686f:6e6b::2";
 
-/// Whether `path` is a mountpoint (appears in /proc/mounts).
+/// Make the namespace registry `dir` a shared mountpoint, as iproute2 and
+/// podman make it. Making a directory shared fails with EINVAL unless it is
+/// a mountpoint; it is then bound onto itself first, recursively, so that
+/// every namespace already registered there stays in view. The kernel
+/// resolves `dir`, symlinks included (`/var/run` and `/run` are symlinks on
+/// some systems). Nothing undoes it: the registry holds other tools'
+/// namespaces, which outlive this process.
 #[cfg(feature = "ebpf")]
-fn is_mountpoint(path: &str) -> bool {
-    std::fs::read_to_string("/proc/mounts")
-        .map(|m| m.lines().any(|l| l.split_whitespace().nth(1) == Some(path)))
-        .unwrap_or(false)
+fn share_netns_registry(dir: &str) -> nix::Result<()> {
+    use nix::mount::{MsFlags, mount};
+    let share = || {
+        mount(
+            None::<&str>,
+            dir,
+            None::<&str>,
+            MsFlags::MS_SHARED | MsFlags::MS_REC,
+            None::<&str>,
+        )
+    };
+    match share() {
+        Err(nix::errno::Errno::EINVAL) => {
+            mount(
+                Some(dir),
+                dir,
+                None::<&str>,
+                MsFlags::MS_BIND | MsFlags::MS_REC,
+                None::<&str>,
+            )?;
+            share()
+        }
+        shared => shared,
+    }
 }
 
 /// Fixture for production-load tests: a real `dae0`/`dae0peer` pair in the
@@ -712,4 +713,66 @@ mod tests {
         let zero_mac = Dae0Setup::read_links(&mut nl, "lo", "lo").expect_err("zero MAC must fail");
         assert!(format!("{zero_mac:#}").contains("MAC"), "{zero_mac:#}");
     }
+
+    /// The registry of named network namespaces is shared: a namespace
+    /// another tool registered stays registered across the daens setup and
+    /// its cleanup, whether it came before the registry was a mountpoint or
+    /// while honk ran (as podman registers its containers').
+    #[test]
+    #[ignore = "requires root; makes private mount and network namespaces"]
+    fn the_netns_registry_keeps_other_tools_namespaces() {
+        use nix::mount::{MsFlags, mount};
+        if unsafe { libc::geteuid() } != 0 {
+            eprintln!("skipping: requires root");
+            return;
+        }
+        std::thread::spawn(|| -> anyhow::Result<()> {
+            nix::sched::unshare(
+                nix::sched::CloneFlags::CLONE_NEWNS | nix::sched::CloneFlags::CLONE_NEWNET,
+            )?;
+            mount(
+                None::<&str>,
+                "/",
+                None::<&str>,
+                MsFlags::MS_PRIVATE | MsFlags::MS_REC,
+                None::<&str>,
+            )?;
+            // A /run of its own, whose registry is no mountpoint yet.
+            mount(
+                Some("tmpfs"),
+                "/run",
+                Some("tmpfs"),
+                MsFlags::empty(),
+                None::<&str>,
+            )?;
+            std::fs::create_dir_all(NETNS_RUN_DIR)?;
+            let register = |name: &str| -> anyhow::Result<String> {
+                let path = format!("{NETNS_RUN_DIR}/{name}");
+                std::fs::File::create(&path)?;
+                mount(
+                    Some("/proc/thread-self/ns/net"),
+                    path.as_str(),
+                    None::<&str>,
+                    MsFlags::MS_BIND,
+                    None::<&str>,
+                )?;
+                Ok(path)
+            };
+            let before = register("before")?;
+            create_daens_namespace()?;
+            let during = register("during")?;
+            cleanup_dae0_interface(None);
+            for path in [before, during] {
+                let kind = nix::sys::statfs::statfs(path.as_str())?.filesystem_type();
+                anyhow::ensure!(
+                    kind == nix::sys::statfs::NSFS_MAGIC,
+                    "{path} no longer names a namespace"
+                );
+            }
+            Ok(())
+        })
+        .join()
+        .expect("the test thread panicked")
+        .expect("the registry kept every namespace");
+    }
 }
