# honk's configuration: nodes, groups, routing and DNS upstreams, in dae's syntax
# as honk reads it. The image carries only this template; the real one lives in
# the private config repository, and config-push installs it.
#
# /etc/init.d/honk runs it inside an entry that adds the interfaces to bind
# (lan_interface), honk's DNS listener (127.0.0.1:5353, which dnsmasq forwards
# to) and the native DNS of private addresses, so neither lan_interface nor
# wan_interface belongs here. The native API stays off until the pushed
# configuration enables it with a token.

global {
	log_level: info
}

routing {
	fallback: direct
}
