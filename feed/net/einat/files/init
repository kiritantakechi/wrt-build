#!/bin/sh /etc/rc.common
# einat on the WAN interface (r4s-ebpf-datapath design D2, D3). procd carries two
# firewall rules with the instance: while einat runs, TCP, UDP and ICMP skip
# masquerade, and the inbound packets einat translated back (marked) are accepted.
# When einat stops, both go with it and masquerade takes over. Without a mark
# (inbound_mark 0) nothing is accepted by mark: a rule for mark 0/0 would match
# every packet.
# shellcheck disable=SC2154 # config_get assigns the options read below

# shellcheck disable=SC2034 # read by /etc/rc.common
START=60
# shellcheck disable=SC2034
USE_PROCD=1

firewall_rules() {
	json_add_array firewall
	json_add_object ''
	json_add_string type nat
	json_add_string name 'einat: no masquerade'
	json_add_string src wan
	json_add_string family ipv4
	json_add_string proto 'tcp udp icmp'
	json_add_string target ACCEPT
	json_close_object
	if [ "$((inbound_mark))" -ne 0 ]; then
		json_add_object ''
		json_add_string type rule
		json_add_string name 'einat: inbound it translated back'
		json_add_string src wan
		json_add_string dest lan
		json_add_string family ipv4
		json_add_string proto 'tcp udp icmp'
		json_add_string mark "${inbound_mark}/${inbound_mark}"
		json_add_string target ACCEPT
		json_close_object
	fi
	json_close_array
}

start_service() {
	config_load einat
	config_get_bool enabled config enabled 0
	[ "${enabled}" = 1 ] || return 0
	config_get ifname config ifname pppoe-wan
	config_get ports config ports 20000-29999
	config_get inbound_mark config inbound_mark 0x20000000

	procd_open_instance
	procd_set_param command /usr/bin/einat --ifname "${ifname}" --nat44 \
		--ports "${ports}" --inbound-mark "${inbound_mark}"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_open_data
	firewall_rules
	procd_close_data
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger einat
}
