#!/bin/sh /etc/rc.common
# dae, bound to the LAN side only (r4s-ebpf-datapath design D1, D5). The service
# runs the entry /var/run/dae/main.dae, written here: the interfaces to bind and
# the DNS listener, then an include of the configuration (option config_file).
# dae includes only files under the entry's directory, so /var/run/dae mirrors
# the configuration's directory with symbolic links: the include, and any the
# configuration makes itself, resolve as if dae ran from there. Whatever writes
# the entry or has dae reload holds /var/lock/dae.lock, and the entry is
# replaced whole, so that a dae starting or reloading meanwhile reads the old one
# or the new (device-integrity D5).
# shellcheck disable=SC2154 # config_get assigns the options read below

# shellcheck disable=SC2034 # read by /etc/rc.common
START=99
# shellcheck disable=SC2034
USE_PROCD=1

extra_command "hot_reload" "Apply the configuration without dropping connections"

PROG=/usr/bin/dae
RUN=/var/run/dae
ENTRY="${RUN}/main.dae"
LOCK=/var/lock/dae.lock
LOG_DIR=/var/log/dae
# How often, and how far apart in seconds, a reload is asked for while dae turns
# it away: while it starts, before its pid file is written, or reloads already.
RELOAD_TRIES=25
RELOAD_INTERVAL=2
# The LAN side: br-lan, and the container and tailnet interfaces while they exist.
INTERFACES="br-lan podman0 tailscale0"

# big_cores: the CPUs of the highest capacity, which are the big cores of a
# big.LITTLE SoC, as a taskset list; empty where the kernel reports no
# capacities (board-model D6).
big_cores() {
	highest=0
	cores=
	for file in /sys/devices/system/cpu/cpu[0-9]*/cpu_capacity; do
		[ -r "${file}" ] || continue
		capacity=$(cat "${file}")
		cpu=${file%/cpu_capacity}
		cpu=${cpu##*/cpu}
		if [ "${capacity}" -gt "${highest}" ]; then
			highest=${capacity}
			cores=${cpu}
		elif [ "${capacity}" -eq "${highest}" ]; then
			cores="${cores},${cpu}"
		fi
	done
	echo "${cores}"
}

# bound: the interfaces dae binds now, comma-separated.
bound() {
	list=
	for interface in ${INTERFACES}; do
		[ -e "/sys/class/net/${interface}" ] && list="${list:+${list},}${interface}"
	done
	echo "${list}"
}

# write_entry: write the entry, and the links beside it, for the configuration
# and the interfaces there are now. Under the lock.
write_entry() {
	config_get config_file config config_file /etc/dae/config.dae
	directory=${config_file%/*}
	interfaces=$(bound)
	# dae refuses configuration files others can read.
	umask 077
	mkdir -p "${RUN}"
	# The links follow the configuration's directory: stale ones go, missing ones come.
	for link in "${RUN}"/*; do
		[ -L "${link}" ] || continue
		target=$(readlink "${link}") || target=
		[ "${target}" = "${directory}/${link##*/}" ] && [ -e "${target}" ] || rm -f "${link}"
	done
	for path in "${directory}"/*; do
		# Never a link where the entry goes: writing it would go through the link.
		[ -e "${path}" ] && [ "${path##*/}" != "${ENTRY##*/}" ] && ln -sfn "${path}" "${RUN}/"
	done
	{
		echo "# Written by /etc/init.d/dae; edit ${config_file} instead."
		printf 'global {\n\tlan_interface: %s\n\tauto_config_kernel_parameter: true\n}\n' "${interfaces}"
		printf "dns {\n\tbind: '127.0.0.1:5353'\n}\n"
		printf 'include {\n\t%s\n}\n' "${config_file##*/}"
	} >"${ENTRY}.new"
	mv "${ENTRY}.new" "${ENTRY}"
}

# write_and_validate: the entry written and validated, under the lock.
write_and_validate() {
	(
		flock 9
		write_entry
		"${PROG}" validate -c "${ENTRY}"
	) 9>"${LOCK}"
}

start_service() {
	config_load dae
	config_get_bool enabled config enabled 0
	[ "${enabled}" = 1 ] || return 0
	write_and_validate || return 1

	config_get log_maxbackups config log_maxbackups 1
	config_get log_maxsize config log_maxsize 1
	config_get_bool cpu_pinning config cpu_pinning 0
	set -- "${PROG}" run -c "${ENTRY}" --disable-timestamp \
		--logfile "${LOG_DIR}/dae.log" \
		--logfile-maxbackups "${log_maxbackups}" --logfile-maxsize "${log_maxsize}"
	if [ "${cpu_pinning}" = 1 ]; then
		cores=$(big_cores)
		[ -z "${cores}" ] || set -- taskset -c "${cores}" "$@"
	fi

	procd_open_instance
	procd_set_param command "$@"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -rf "${LOG_DIR}"
}

# reload_service: apply the configuration: stop dae when it is turned off, start
# it when it does not run, and have it reload otherwise, asking again while it
# turns the reload away.
reload_service() {
	config_load dae
	config_get_bool enabled config enabled 0
	if [ "${enabled}" != 1 ]; then
		stop
		return 0
	fi
	if ! running; then
		start
		return
	fi
	(
		flock 9
		write_entry
		"${PROG}" validate -c "${ENTRY}" || exit 1
		tries=${RELOAD_TRIES}
		until "${PROG}" reload >/dev/null 2>&1; do
			tries=$((tries - 1))
			[ "${tries}" -gt 0 ] || exit 1
			sleep "${RELOAD_INTERVAL}"
		done
	) 9>"${LOCK}"
}

hot_reload() {
	reload_service
}

service_triggers() {
	procd_add_reload_trigger dae
}
