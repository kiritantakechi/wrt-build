# GCC 15 + LTO + mold + gc-sections for all target packages.
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_USE_LTO=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_MOLD=y
# Target packages build at -O3 (docs/optimization.md). TARGET_CFLAGS is
# TARGET_OPTIMIZATION, then EXTRA_OPTIMIZATION (rules.mk), so the -O3 here wins
# over the target's default -Os. Each board's seed puts its big.LITTLE -mcpu
# after it; the toolchain every board shares is built without one (board-model
# D2). Never -Ofast or -ffast-math: ucode's numbers and the shaping arithmetic
# of qosify and cake rely on IEEE semantics (toolchain-o3 D2).
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt -O3"
# The target's default, plus the UB-indicative warnings that packages without
# -Wall would miss, and -Wshift-negative-value, which not even -Wall enables
# (docs/undefined-behavior.md). This variable reaches the
# target packages only, never the kernel. TARGET_OPTIONS makes it settable; on
# aarch64 that menu holds nothing else.
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=generic -Warray-bounds -Wuninitialized -Wmaybe-uninitialized -Wstrict-aliasing -Wuse-after-free -Wdangling-pointer -Wshift-negative-value"
# The kernel and its modules stay at -O2, which is all upstream Linux supports:
# KCFLAGS are EXTRA_OPTIMIZATION without -fno-plt, then KERNEL_CFLAGS
# (include/kernel.mk), so this -O2 comes last and wins.
CONFIG_KERNEL_CFLAGS="-O2"
# BPF objects are compiled with the clang pinned by flake.nix instead of building llvm-bpf.
CONFIG_BPF_TOOLCHAIN_HOST=y
# Host Go (for dae) builds with the Go that flake.nix pins, rather than with a
# downloaded bootstrap, which OpenWrt does not offer for arm64 hosts.
CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/share/go"
# CONFIG_GOLANG_BUILD_BOOTSTRAP is not set
# Rust packages compile through sccache, the Rust counterpart of ccache, whose
# cache lives beside the tree with ccache's and Go's (build-acceleration D6).
CONFIG_RUST_SCCACHE=y
