# GCC 15 + LTO + mold + gc-sections for all target packages.
# -O2 comes after the default -Os/-mcpu in TARGET_CFLAGS (rules.mk: TARGET_CFLAGS
# = TARGET_OPTIMIZATION + EXTRA_OPTIMIZATION), so it wins. Each board's seed puts
# its big.LITTLE -mcpu after it; the toolchain every board shares is built
# without one (board-model D2).
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_USE_LTO=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_MOLD=y
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt -O2"
# BPF objects are compiled with the clang pinned by flake.nix instead of building llvm-bpf.
CONFIG_BPF_TOOLCHAIN_HOST=y
# Host Go (for dae) builds with the Go that flake.nix pins, rather than with a
# downloaded bootstrap, which OpenWrt does not offer for arm64 hosts.
CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT="/usr/share/go"
# CONFIG_GOLANG_BUILD_BOOTSTRAP is not set
