# Local development builds: only the selected packages and kmods, with a log per
# package, so a failure in a parallel build can be read afterwards.
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y
# One kmod built but not installed, so the system tests can install a kmod from
# the repository of the same build (the ci profile builds every kmod anyway).
CONFIG_PACKAGE_kmod-dummy=m
