# Kernel configuration overlay. scripts/config.sh links it to
# $TREE/env/kernel-config, the last layer of LINUX_KCONFIG_LIST
# (include/target.mk), for symbols that have no CONFIG_KERNEL_* option.
#
# Every line must appear unchanged in the built kernel's .config; scripts/build.sh
# checks it. Enabling a symbol can make new ones visible, and the kernel
# configuration stops on any visible symbol without a value, so each group lists
# them too: find them with `make listnewconfig` on the merged configuration.

# f2fs overlay compression (fstools_overlay_compression_type=zstd)
CONFIG_F2FS_FS_COMPRESSION=y
# CONFIG_F2FS_FS_LZO is not set
CONFIG_F2FS_FS_LZ4=y
# CONFIG_F2FS_FS_LZ4HC is not set
CONFIG_F2FS_FS_ZSTD=y

# QEMU virt guest: the shipped kernel boots unchanged in the emulator, from the
# factory image as an SD card on sdhci-pci (r4s-ab-rollback D7). PL011 is already
# built in by the rockchip configuration.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_MMC_SDHCI_PCI=y
# CONFIG_MMC_RICOH_MMC is not set
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_I6300ESB_WDT=y
# modern virtio only; every other virtio device stays off
# CONFIG_VIRTIO_PCI_LEGACY is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_ARM_SCMI_TRANSPORT_VIRTIO is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set
# CONFIG_GPIO_VIRTIO is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_NSM is not set
# CONFIG_SPI_VIRTIO is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_DEBUG is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_IOMMU is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_RTC is not set
