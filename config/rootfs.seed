# EROFS root (lz4hc) with an f2fs overlay; no squashfs or ext4 root images.
CONFIG_TARGET_ROOTFS_EROFS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# A/B slots (r4s-ab-rollback): two boot partitions of this size, each holding a
# kernel FIT and the configuration handed over on upgrade.
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_PACKAGE_wrt-ab=y
# The emulator's U-Boot: a test artifact, built with every image, installed nowhere.
CONFIG_PACKAGE_u-boot-wrt-qemu=y
